// GIUpdate.compute
// Per-voxel runtime GI update compute shader.
// - Ping-pong read/write radiance fields
// - Supports HDR (LOTEC_GI_HDR) and LDR (octa-packed direction in alpha)
// - Simple raymarch / sphere-trace against a 3D SDF field

#pragma kernel CSMain

#include "UnityCG.cginc"

// Configuration constants (set from C# or via shader keywords)
CBUFFER_START(UnityPerObject)
    uint3 _Resolution;            // voxel grid resolution
    float3 _BoundsMin;
    float3 _BoundsSize;
    uint _RaysPerVoxel;
    float _MaxRayDistance;
    uint _FrameIndex;
    uint _RandomSeed;
CBUFFER_END

// Textures
Texture3D<float> _SdfField;               // signed distance in world units
Texture3D<float4> _MaterialFieldA;        // RGB = albedo, A = roughness
Texture3D<float4> _MaterialFieldB;        // RGB = emission, A = metallic (optional)

// Ping-pong radiance fields (read/write are bound by the C# manager appropriately)
Texture3D<float4> _RadianceRead;          // read radiance from previous frame
RWTexture3D<float4> _RadianceWrite;       // write updated radiance this frame

// Control field contains direction / stability / shadow info
// R: Octahedral packed direction of brightest light, G: 100% Shadow? (0,1), A: Stability (0-255)
RWTexture3D<float4> _ControlField; // Måste nog ändra till uint4

SamplerState linearClampSampler {
    Filter = MIN_MAG_MIP_LINEAR;
    AddressU = Clamp;
    AddressV = Clamp;
    AddressW = Clamp;
};

// Hash RNG (Wang hash) + float rand
uint wangHash(uint x) {
    x = (x ^ 61u) ^ (x >> 16);
    x *= 9u;
    x = x ^ (x >> 4);
    x *= 0x27d4eb2du;
    x = x ^ (x >> 15);
    return x;
}

float rnd(inout uint state) {
    state = wangHash(state + 0x9e3779b9u);
    return (state & 0x00FFFFFFu) / 16777216.0;
}

// Octahedral encode / decode (normalized direction <-> 2D)
float2 OctaEncode(float3 n) {
    n /= abs(n.x) + abs(n.y) + abs(n.z);
    float2 enc = n.xy;
    if (n.z < 0.0) {
        enc = (1.0 - abs(float2(enc.y, enc.x))) * (enc.xy >= 0 ? 1.0 : -1.0);
    }
    return enc;
}

float3 OctaDecode(float2 f) {
    float3 v = float3(f.xy, 1.0 - abs(f.x) - abs(f.y));
    if (v.z < 0.0) {
        v.xy = (1.0 - abs(v.yx)) * (v.xy >= 0 ? 1.0 : -1.0);
        v.z = 1.0 - abs(v.x) - abs(v.y);
    }
    return normalize(v);
}

// Pack octahedral into a single 8-bit value (two 4-bit components)
uint PackDirToU8(float3 dir) {
    float2 e = OctaEncode(normalize(dir));
    // Map from [-1,1] -> [0,15]
    int ix = (int)round(saturate((e.x * 0.5 + 0.5) * 15.0));
    int iy = (int)round(saturate((e.y * 0.5 + 0.5) * 15.0));
    return (uint)((ix & 15) << 4) | (uint)(iy & 15);
}

float3 UnpackDirFromU8(uint packed) {
    int ix = (packed >> 4) & 15;
    int iy = packed & 15;
    float2 e = float2(ix / 15.0 * 2.0 - 1.0, iy / 15.0 * 2.0 - 1.0);
    return OctaDecode(e);
}

// Sample SDF value at world position (trilinear)
float SampleSDF(float3 worldPos) {
    float3 uvw = (worldPos - _BoundsMin) / _BoundsSize;
    return _SdfField.SampleLevel(linearClampSampler, uvw, 0).x;
}

// Sample material fields at world position
void SampleSurfaceMaterial(float3 worldPos, out float3 albedo, out float roughness, out float3 emission) {
    float3 uvw = (worldPos - _BoundsMin) / _BoundsSize;
    float4 a = _MaterialFieldA.SampleLevel(linearClampSampler, uvw, 0);
    float4 b = _MaterialFieldB.SampleLevel(linearClampSampler, uvw, 0);
    albedo = a.xyz;
    roughness = saturate(a.w);
    emission = b.xyz;
}

// Sphere-trace / raymarch returning hit factor (0..1) and hit position
float Raymarch(in float3 start, in float3 dir, out float3 hitPos) {
    float t = 0.0;
    const int MAX_STEPS = 64;
    for (int i = 0; i < MAX_STEPS; ++i) {
        float3 p = start + dir * t;
        float d = SampleSDF(p);
        if (d < 0.001) { hitPos = p; return 1.0; } // hit
        t += max(d * 0.5, 0.01);
        if (t > _MaxRayDistance) break;
    }
    hitPos = start + dir * _MaxRayDistance;
    return 0.0;
}

// Compute incoming light (very simplified): use emission + albedo scaled by roughness
float3 ComputeIncomingLight(float3 albedo, float roughness, float3 emission, float hit) {
    // Simple Lambert-like contribution modulated by roughness
    float refl = lerp(1.0 - roughness, 0.5, roughness);
    return emission + albedo * 0.5 * refl * hit;
}


/// Run on each voxel
[numthreads(8,8,4)]
void CSMain(uint3 id : SV_DispatchThreadID) {
    if (any(id >= uint3(_Resolution.xyz))) return;

    int3 idx = int3(id.x, id.y, id.z);
    // compute world position at voxel center
    float3 localNorm = (float3(idx) + 0.5) / float3(_Resolution);
    float3 worldPos = _BoundsMin + localNorm * _BoundsSize;
    // float3 worldPos = _BoundsMin + (float3(id) * _VoxelSize) + (_VoxelSize * 0.5);

    // Read this voxel info from last frame
    float4 prevRadianceData = _RadianceRead.SampleLevel(linearClampSampler, localNorm, 0);
    float4 control = _ControlField.Load(int3(idx));
    float3 accum = prevRadianceData.rgb;

    // Build RNG state using unsigned arithmetic to avoid signed/unsigned mismatch warnings on Vulkan
    uint state = _RandomSeed + (_FrameIndex * 9781u) + (((uint)id.x * 73856093u) ^ ((uint)id.y * 19349663u) ^ ((uint)id.z * 83492791u));

    // Unpack dominant direction from previous frame
    float3 dominantLightDir = normalize(control.rgb); // TODO: Ensure it is written normalized instead.
    float maxBrightness = control.a;

    // compute safe reciprocal for averaging
    float invRays = (_RaysPerVoxel > 0u) ? (1.0 / (float)_RaysPerVoxel) : 0.0;

    float3 incomingLight = 0;
    for (uint r = 0; r < _RaysPerVoxel; ++r) {
        // sample a totally random direction on the unit sphere (uniform)
        float u1 = rnd(state);
        float u2 = rnd(state);
        float z = 1.0 - 2.0 * u1;
        float phi = 2.0 * UNITY_PI * u2;
        float rxy = sqrt(max(0.0, 1.0 - z*z));
        float x = rxy * cos(phi);
        float y = rxy * sin(phi);
        float3 rayDir = normalize(float3(x, y, z));

        // Raymarch
        float3 hitPos;
        float hit = Raymarch(worldPos, rayDir, hitPos);
        if (hit > 0.0) {
            // Sample Material at Hit Position
            float3 albedo; float roughness; float3 emission;
            SampleSurfaceMaterial(hitPos, albedo, roughness, emission);

            // Sample indirect light at hit position voxel (from previous frame)
            // We sample the Radiance Field at the hit location to get multi-bounce GI
            float3 uvwHit = (hitPos - _BoundsMin) / _BoundsSize;
            float4 indirect = _RadianceRead.SampleLevel(linearClampSampler, uvwHit, 0);

            // Add surface bounced light: include a direct-like term so the field can bootstrap
            // Compute a simple direct contribution and add indirect*albedo. Add a tiny ambient seed.
            float3 directLike = ComputeIncomingLight(albedo, roughness, emission, hit);
            float3 bounceLight = directLike + indirect.rgb * albedo.rgb * 0.5 + 0.02 * albedo.rgb;
            incomingLight += bounceLight;

            // Track Dominant Direction
            // If this ray found a very bright spot, remember the direction
            float brightness = dot(bounceLight, float3(0.2126,0.7152,0.0722));
            if (brightness > maxBrightness) {
                maxBrightness = brightness;
                dominantLightDir = rayDir;
            }
        }
    }
    incomingLight *= invRays;

    // --- 3. TEMPORAL INTEGRATION ---
    // Blend new light with history to reduce noise
    // _TemporalBlend should be around 0.90 to 0.98
    float3 finalLight = lerp(incomingLight, accum, 0.95);
    // Write accumulated radiance
    _RadianceWrite[int3(idx)] = float4(finalLight, 1.0);
    // Store direction + brightness in control field
    uint octaDir = PackDirToU8(dominantLightDir);
    _ControlField[int3(idx)] = float4(octaDir, maxBrightness, 0, 0);
}
