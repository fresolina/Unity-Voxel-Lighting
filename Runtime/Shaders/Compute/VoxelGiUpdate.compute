#pragma kernel CSMain
#pragma kernel CSComputeIrradiance
#pragma kernel CSClearVolume

// --- CONSTANTS ---
#define MAX_SDF_DIST 30.0
#define EPSILON 0.001

#include "../Includes/Volume.hlsl"
#include "../Includes/VoxelSdfShadows.hlsl"
#include "../Includes/Raymarch.hlsl"
#include "../Includes/Fibonacci.hlsl"

// --- RESOURCES ---

// Inputs (Read Only)
Texture3D<float4> _MaterialAlbedoRoughness; // RGB = Albedo, A = Roughness
Texture3D<float4> _MaterialEmissionMetallic; // RGB = Emission, A = Metallic
Texture3D<float> _DistanceField; // Low-res

// GI field buffers
Texture3D<float4> _RadianceField;          // Current Frame Radiance (read in irradiance pass)
RWTexture3D<float4> _RadianceFieldWrite;   // Current Frame Radiance (write in radiance pass)
Texture3D<float4> _IrradianceFieldHistory; // Previous Frame Irradiance (read in both passes)
RWTexture3D<float4> _IrradianceFieldWrite; // Current Frame Irradiance (write in irradiance pass)

Texture3D<float4> _ControlRead;      // Previous Frame Control
RWTexture3D<float4> _ControlWrite;   // Current Frame Control

// Samplers
SamplerState linearClampSampler;
SamplerState pointClampSampler;  // For precise SDF reads

// --- UNIFORMS ---
float3 _RadianceTextureSize;
float3 _VoxelSize;
uint _FrameCount;
uint _MaxSamples;
uint _RaysPerFrame;
float _IrradianceStability;
uint _IrradianceFieldSampleCount;
float3 _DirectLightDir;
float4 _DirectLightColor;
float3 _SkyColor;

// --- HELPERS ---

float SampleSDF(float3 pos) {
    float3 uvw = WorldToVoxelUV(pos);
    return _DistanceField.SampleLevel(linearClampSampler, uvw, 0).r;
}
// Calculate normal from SDF gradient
float3 GetNormalFromSDF(float3 pos) {
    float2 k = float2(1, -1);
    float3 h = _VoxelSize * 0.1; // Sampling step size
    
    // Tetrahedron technique (efficient gradient calculation)
    // You need to call your SDF sampling function here. 
    // Assuming SampleSDF(pos) returns distance.
    return normalize(
        k.xyy * SampleSDF(pos + k.xyy * h) + 
        k.yyx * SampleSDF(pos + k.yyx * h) + 
        k.yxy * SampleSDF(pos + k.yxy * h) + 
        k.xxx * SampleSDF(pos + k.xxx * h)
    );
}

float RaymarchSDF(float3 voxelCenter, float3 rayDir, out float3 hitPos) {
    return RayMarchTex3D(_DistanceField, linearClampSampler, voxelCenter, rayDir, _VolumePosition, _VolumeSize, 0, MAX_SDF_DIST, EPSILON, 0.01, 64, 0.5, hitPos);
}

float3 GetRandomDirection(float3 seedPos) {
    float r1 = Random(seedPos, _FrameCount);
    float r2 = Random(seedPos, _FrameCount + 1.34);
    float r3 = Random(seedPos, _FrameCount + 2.51);
    return normalize(float3(r1 - 0.5, r2 - 0.5, r3 - 0.5));
}
// Map 1D noise to Sphere Direction
// (Golden Angle Sampling for better distribution than random)
float3 GetRandomDirectionFromNoise(float noiseVal) {
    float z = 1.0 - 2.0 * noiseVal;
    float r = sqrt(max(0.0, 1.0 - z * z));
    float phi = 2.0 * 3.14159 * frac(noiseVal * 1.61803); // Golden ratio
    return float3(r * cos(phi), r * sin(phi), z);
}

// --- DEBUG: Clear Kernel ---
RWTexture3D<float4> _ClearTarget;
[numthreads(8,8,8)]
void CSClearVolume(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= uint3(_RadianceTextureSize.xyz))) return;

    _ClearTarget[id] = float4(0.0, 0.0, 0.0, 0.0);
}

// ----------------------------------------------------------
// Radiance field calculation
// A voxel radiates light when it is close to a surface and has incoming light.
// ----------------------------------------------------------
[numthreads(8, 8, 8)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    if (any(id >= uint3(_RadianceTextureSize.xyz))) return;

    float3 voxelCenter = _VolumePosition + (float3(id) * _VoxelSize) + (_VoxelSize * 0.5);
    float3 uvw = WorldToVoxelUV(voxelCenter);
    
    // ----------------------------------------------------------
    // 1. Should we radiate?
    // ----------------------------------------------------------
    // Fetch exact distance to nearest surface (no interpolation, use pointSampler).
    // TODO: Possibly support dynamic SDFs, for dynamic objects radiating light.
    float dist = _DistanceField.SampleLevel(pointClampSampler, uvw, 0).r;
    // If a surface is close, we consider this voxel a surface voxel that can radiate.
    // bool shouldRadiate = dist > 0 && dist <= _VoxelSize.x;
    bool shouldRadiate = dist > 0;
    if (!shouldRadiate) return; // Abort if inside geometry.
    
    // ----------------------------------------------------------
    // 2. Calculate radiation
    // ----------------------------------------------------------
    float3 outgoingLight = float3(0, 0, 0);
    // Get direct sun light. TODO: Optimize by sampling a shadowmap as a crude first step, then only raymarch if needed?
    float3 hitPos; // TODO: Not needed here.
    float sunVisibility = RaymarchSDF(voxelCenter, _DirectLightDir, hitPos); // What should dir be?
    float3 sunLight = _DirectLightColor.rgb * sunVisibility;
    // Get indirect light from GI field.
    // Get corner position for more linear interpolation blur.
    float3 voxelCornerUVW = WorldToVoxelUV(voxelCenter + _VoxelSize * 0.5);
    float3 surfaceIrradiance = _IrradianceFieldHistory.SampleLevel(linearClampSampler, voxelCornerUVW, 0).rgb;
    // float3 surfaceIrradiance = float3(0,0,0);
    // Radiate incoming light (sun + indirect) modulated by surface albedo and roughness.
    float4 albedoRoughness = _MaterialAlbedoRoughness.SampleLevel(linearClampSampler, uvw, 0);
    outgoingLight = (surfaceIrradiance + sunLight) * albedoRoughness.rgb;

    // ----------------------------------------------------------
    // 3. Store radiation (with temporal blend)
    // ----------------------------------------------------------
    // Store new radiance value.
    _RadianceFieldWrite[id] = float4(outgoingLight, 1.0f);
}

// ----------------------------------------------------------
// IRRADIANCE PASS
// How much light is arriving at this voxel.
// ----------------------------------------------------------
[numthreads(8, 8, 8)]
void CSComputeIrradiance(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= uint3(_RadianceTextureSize.xyz))) return;

    float4 history = _IrradianceFieldHistory.Load(int4(id, 0));
    float3 oldColor = history.rgb;
    if (_IrradianceFieldSampleCount >= _MaxSamples) {
        _IrradianceFieldWrite[id] = history;
        // _IrradianceFieldWrite[id] = float4(history, 1.0);
        return; // We are stable, no need to keep accumulating.
    }

    float3 voxelCenter = _VolumePosition + (float3(id) * _VoxelSize) + (_VoxelSize * 0.5);
    float3 uvw = WorldToVoxelUV(voxelCenter);
    float dist = _DistanceField.SampleLevel(pointClampSampler, uvw, 0).r;
    // bool hasSurface = dist > 0 && dist <= _VoxelSize.x;
    bool hasLight = dist > 0;
    if (!hasLight) return; // Abort if inside geometry.

    // Shoot random rays to gather incoming light from anything it hits.
    float3 incomingLight = float3(0,0,0);
    // Build a stable, decorrelated seed from voxel id + frame + sample index
    uint baseSeed = id.x * 73856093u ^ id.y * 19349663u ^ id.z * 83492791u;
    for (uint i = 0; i < _RaysPerFrame; i++) {
        uint seed = baseSeed;
        seed ^= (_FrameCount * 1664525u);
        seed += (uint)i * 1013904223u;
        float noiseVal = HashTo01(seed);
        // float3 rayDir = GetRandomDirectionFromNoise(noiseVal);
        float3 rayDir = FibonacciDirection64((baseSeed + _FrameCount + i) & 63u); // DEBUG: test with fixed directions

        float3 hitPos;
        float lit = RaymarchSDF(voxelCenter, rayDir, hitPos);
        if (lit < 0.99f && lit > 0) {
            // Read Radiance from "surface" at hit point.
            // Radiance is stored one voxel away from the surface.
            float3 samplePos = hitPos - rayDir * _VoxelSize;
            float3 hitUV = WorldToVoxelUV(samplePos);
            float3 hitRadiance = _RadianceField.SampleLevel(linearClampSampler, hitUV, 0).rgb;
            incomingLight += hitRadiance;
        }
    }
    incomingLight /= _RaysPerFrame;
    // Accumulate median value over time to get a more stable estimate of the true irradiance.
    float3 finalColor = lerp(oldColor, incomingLight, _IrradianceStability);

    _IrradianceFieldWrite[id] = float4(finalColor, 1.0);
}
