#pragma kernel CSComputeRadiance
#pragma kernel CSComputeIrradiancePathTracing
#pragma kernel CSComputeIrradianceLPV
#pragma kernel CSBlurIrradiance
#pragma kernel CSClearVolume

// --- CONSTANTS ---
// LPV neighbor propagation factor
#define LPV_PROPAGATION_STRENGTH 0.97
// LPV midpoint occlusion threshold
#define LPV_OCCLUSION_THRESHOLD 0.0

#include "../Includes/Volume.hlsl"
#include "../Includes/Fibonacci.hlsl"

// --- RESOURCES ---

// Inputs (Read Only)
Texture3D<float4> _MaterialAlbedoIntensity; // RGB = Albedo, A = Emission Intensity

// GI field buffers
Texture3D<float4> _RadianceField;          // Current Frame Radiance (read in irradiance pass)
RWTexture3D<float4> _RadianceFieldWrite;   // Current Frame Radiance (write in radiance pass)
Texture3D<float4> _IrradianceFieldHistory; // Previous Frame Irradiance (read in both passes)
RWTexture3D<float4> _IrradianceFieldWrite; // Current Frame Irradiance (write in irradiance pass)
Texture3D<float4> _IrradianceFieldInput;   // Temporal irradiance (read in blur pass)
RWTexture3D<float4> _IrradianceFieldFinal; // Final blurred irradiance

// Blue noise for stochastic sampling
Texture2D<float> _BlueNoiseTex;

// --- UNIFORMS ---
float3 _RadianceTextureSize;
uint _FrameCount;
uint _MaxSamples;
uint _RaysPerFrame;
float3 _DirectLightDir;
float4 _DirectLightColor;
float3 _SkyColor;
float _LpvDecay;

// --- DEBUG: Clear Kernel ---
RWTexture3D<float4> _ClearTarget;
[numthreads(8,8,8)]
void CSClearVolume(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= uint3(_RadianceTextureSize.xyz))) return;

    _ClearTarget[id] = float4(0.0, 0.0, 0.0, 0.0);
}

// ----------------------------------------------------------
// RADIANCE PASS
// Calculate how much light this voxel emits.
// ----------------------------------------------------------
[numthreads(8, 8, 8)]
void CSComputeRadiance(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= uint3(_RadianceTextureSize.xyz))) return;

    float3 voxelCenter = _VolumePosition + (float3(id) * _VoxelSize) + (_VoxelSize * 0.5);
    float3 uvw = WorldToVoxelUV(voxelCenter);
    float dist = _DistanceField.SampleLevel(pointClampSampler, uvw, 0).r;

    // Only near-surface voxels radiate.
    bool shouldRadiate = dist > 0 && dist <= _VoxelSize.x;
    if (!shouldRadiate) {
        _RadianceFieldWrite[id] = 0;
        return;
    }

    // Get indirect light from GI field.
    float3 surfaceIrradiance = _IrradianceFieldHistory.SampleLevel(pointClampSampler, uvw, 0).rgb;
    // Get direct sun light
    // TODO: Support another direct light source, like a flashlight.
    // TODO: Optimize by sampling a shadowmap as a crude first step, then only raymarch if needed?
    float3 hitPos;
    float sunVisibility = RaymarchSDF(voxelCenter, _DirectLightDir, hitPos);
    float3 sunLight = _DirectLightColor.rgb * sunVisibility;
    // Get surface albedo and emissive intensity (alpha is 8-bit log-encoded intensity)
    float4 albedoIntensity = _MaterialAlbedoIntensity.SampleLevel(pointClampSampler, uvw, 0);
    float emissionIntensity = DecodeEmissionIntensityFrom8Bit(albedoIntensity.a);
    float3 emissiveLight = albedoIntensity.rgb * emissionIntensity;

    // Radiate reflected incoming light plus emissive contribution.
    // float3 safeAlbedo = min(albedoIntensity.rgb, float3(0.9f, 0.9f, 0.9f));
    float3 safeAlbedo = albedoIntensity.rgb;
    float3 outgoingLight = ((surfaceIrradiance + sunLight) * safeAlbedo.rgb) + emissiveLight;
    _RadianceFieldWrite[id] = float4(outgoingLight, 1.0);
}

// ----------------------------------------------------------
// IRRADIANCE PASS
// How much light is arriving at this voxel.
// ----------------------------------------------------------
[numthreads(8, 8, 8)]
void CSComputeIrradiancePathTracing(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= uint3(_RadianceTextureSize.xyz))) return;

    float3 voxelCenter = _VolumePosition + (float3(id) * _VoxelSize) + (_VoxelSize * 0.5);
    float3 uvw = WorldToVoxelUV(voxelCenter);
    // Abort if inside geometry.
    half dist = _DistanceField.SampleLevel(pointClampSampler, uvw, 0).r;
    if (dist < 0) {
        _IrradianceFieldWrite[id] = 0;
        return;
    }
    bool isAir = (dist > _VoxelSize.x);

    float3 incomingLight = float3(0, 0, 0);
    float3 surfaceNormal = GetNormalFromSDF(voxelCenter);
    uint rayCount = max(_RaysPerFrame, 1u);

    [loop] // TODO: Change to [unroll] and rayCount to compile time constant (1=Mobile, 4=PC)
    for (uint rayIndex = 0u; rayIndex < rayCount; rayIndex++) {
        float2 noise2 = GetBlueNoise2(_BlueNoiseTex, id, _FrameCount, rayIndex);
        half3 rayDir;
        if (isAir) {
            rayDir = CosineSampleHemisphere(surfaceNormal, noise2);
        } else {
            rayDir = GetRandomDirectionFromNoise2(noise2);
        }

        float3 hitPos;
        float lit = RaymarchSDF(voxelCenter, rayDir, hitPos);
        if (lit == 0) {
            // Sample value half a voxel away from the surface hit point, to avoid sampling a voxel center inside the surface.
            float3 surfaceUVW = WorldToVoxelUV(hitPos - rayDir * _VoxelSize * 0.51);
            incomingLight += _RadianceField.SampleLevel(linearClampSampler, surfaceUVW, 0).rgb;
        } else {
            // No hit means we get sky light.
            incomingLight += _SkyColor * lit;
        }
    }

    incomingLight *= rcp((float)rayCount);

    float4 history = _IrradianceFieldHistory.Load(int4(id, 0));
    float3 oldColor = history.rgb;
    float weight = 1.0f / (_MaxSamples * 2);
    float3 finalColor = lerp(oldColor, incomingLight, weight);

    _IrradianceFieldWrite[id] = float4(finalColor, 1.0);
}

// Light Propagation Volumes (LPV) in this implementation:
// 1) Gather irradiance from the 6 axis-aligned neighbors.
// 2) Reject propagation through potential walls using an SDF midpoint test.
// 3) Inject fresh radiance from this voxel (emissive + reflected/direct from radiance pass).
// 4) Apply damping controls to prevent runaway brightening over many frames.
[numthreads(8, 8, 8)]
void CSComputeIrradianceLPV(uint3 id : SV_DispatchThreadID)
{
    // Early exit if out of bounds (can happen with non-dispatch-aligned volume sizes)
    if (any(id >= uint3(_RadianceTextureSize.xyz))) return;

    float3 voxelCenter = _VolumePosition + (float3(id) * _VoxelSize) + (_VoxelSize * 0.5);
    half dist = _DistanceField.Load(int4(id, 0)).r;
    if (dist < 0) {
        _IrradianceFieldWrite[id] = 0;
        return;
    }

    float3 sum = 0.0;
    const int3 neighborOffsets[6] = {
        int3(1, 0, 0),
        int3(-1, 0, 0),
        int3(0, 1, 0),
        int3(0, -1, 0),
        int3(0, 0, 1),
        int3(0, 0, -1)
    };
    float3 maxNeighbor = 0.0; // Track the brightest neighbor!

    [unroll]
    for (int i = 0; i < 6; i++) {
        int3 delta = neighborOffsets[i];
        int3 n = id + delta;
        if (any(n < 0) || any(n >= _RadianceTextureSize)) continue;

        // Prevent light leaking through walls, by excluding neighbors inside geometry.
        // float3 midPos = voxelCenter + float3(delta) * (_VoxelSize * 0.5);
        float3 midPos = voxelCenter + float3(delta) * _VoxelSize;
        float midDist = SampleSDF(midPos);
        if (midDist <= LPV_OCCLUSION_THRESHOLD)
            continue;

        float3 neighborLight = _IrradianceFieldHistory.Load(int4(n, 0)).rgb;
        sum += neighborLight;
        // Keep track of the absolute brightest light feeding into this voxel
        maxNeighbor = max(maxNeighbor, neighborLight);
    }

    // Add lights from neighbors together, but clamp to brightest neighbor.
    float3 propagated = min(sum, maxNeighbor);
    // Controls "how fast" light travels through the grid per iteration.
    // 1.0 = full neighbor average, lower values = slower spread.
    propagated *= LPV_PROPAGATION_STRENGTH;

    // Decay controls retention of propagated light.
    // Inverted decay (1 - decay) is used as radiance injection weight.
    float3 injectedRadiance = _RadianceField.Load(int4(id, 0)).rgb * (1.0 - _LpvDecay);
    float3 incomingLight = max((propagated * _LpvDecay) + injectedRadiance, 0.0);
    _IrradianceFieldWrite[id] = float4(incomingLight, 1.0);
}

// ----------------------------------------------------------
// SPATIAL BLUR PASS
// Turbo 8-tap blur: sample voxel corners with linear sampling.
// ----------------------------------------------------------
[numthreads(8, 8, 8)]
void CSBlurIrradiance(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= uint3(_RadianceTextureSize.xyz))) return;

    float3 voxelCenter = _VolumePosition + (float3(id) * _VoxelSize) + (_VoxelSize * 0.5);
    float3 uvwCenter = WorldToVoxelUV(voxelCenter);
    float3 uvwHalf = (_VoxelSize * 0.5) * rcp(max(_VolumeSize, 1e-6));

    // _IrradianceFieldFinal[id] = _IrradianceFieldInput.SampleLevel(linearClampSampler, uvwCenter, 0);
    // return;

    float3 sum = 0.0;
    sum += _IrradianceFieldInput.SampleLevel(linearClampSampler, uvwCenter + float3(-uvwHalf.x, -uvwHalf.y, -uvwHalf.z), 0).rgb;
    sum += _IrradianceFieldInput.SampleLevel(linearClampSampler, uvwCenter + float3( uvwHalf.x, -uvwHalf.y, -uvwHalf.z), 0).rgb;
    sum += _IrradianceFieldInput.SampleLevel(linearClampSampler, uvwCenter + float3(-uvwHalf.x,  uvwHalf.y, -uvwHalf.z), 0).rgb;
    sum += _IrradianceFieldInput.SampleLevel(linearClampSampler, uvwCenter + float3( uvwHalf.x,  uvwHalf.y, -uvwHalf.z), 0).rgb;
    sum += _IrradianceFieldInput.SampleLevel(linearClampSampler, uvwCenter + float3(-uvwHalf.x, -uvwHalf.y,  uvwHalf.z), 0).rgb;
    sum += _IrradianceFieldInput.SampleLevel(linearClampSampler, uvwCenter + float3( uvwHalf.x, -uvwHalf.y,  uvwHalf.z), 0).rgb;
    sum += _IrradianceFieldInput.SampleLevel(linearClampSampler, uvwCenter + float3(-uvwHalf.x,  uvwHalf.y,  uvwHalf.z), 0).rgb;
    sum += _IrradianceFieldInput.SampleLevel(linearClampSampler, uvwCenter + float3( uvwHalf.x,  uvwHalf.y,  uvwHalf.z), 0).rgb;

    _IrradianceFieldFinal[id] = float4(sum * 0.125f, 1.0);
}
