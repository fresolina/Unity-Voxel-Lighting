// Buffer-GI compute: the textureless, cache-resident voxel GI solve.
//   CSClear     - zero the dynamic fields.
//   CSInject    - per solid voxel: outgoing radiance = emissive + albedo*(direct + bounce), where
//                 bounce is the surface's own front-hemisphere incident irradiance (from CSGather).
//   CSGather    - per voxel, 1+ rays/frame + in-place temporal EMA: AIR = omnidirectional irradiance
//                 probe (sampled by the fragment read); SOLID = front-hemisphere incident irradiance
//                 (feeds CSInject's bounce, so a surface no longer reads its own radiance back).
//   CSBlur      - occupancy-gated spatial blur into _IrradianceBlur (hides the 1-ray/frame shimmer
//                 the temporal EMA leaves behind); the fragment read samples the blurred buffer.
// Occupancy/albedo (_Material) is voxelized separately by BufferGiVoxelize.shader (GPU raster).
// Everything else (visibility, occupancy) reads the flat _Material buffer - no SDF, no textures.
#pragma kernel CSClear
#pragma kernel CSInject
#pragma kernel CSGather
#pragma kernel CSBlur
#pragma kernel CSInitFineFromCoarse

#define MAX_POINT_LIGHTS 4
#define MAX_SPOT_LIGHTS 4

#include "../Includes/BufferGiField.hlsl"
#include "../Includes/Math.hlsl"

// --- Fields ---
RWStructuredBuffer<uint2> _Radiance;    // outgoing radiance (fp16x3), stored in solid voxels
RWStructuredBuffer<uint2> _Irradiance;  // accumulated incoming light (rgb) + sample count (w)
RWStructuredBuffer<uint2> _IrradianceBlur; // spatially blurred irradiance, sampled by the fragment read
StructuredBuffer<uint>    _Material;      // occupancy/material (voxelized by BufferGiVoxelize.shader)

// --- Solve uniforms ---
uint  _FrameCount;
uint  _SamplesPerFrame;
float _Confidence; // 0 at a light change, 1 when converged; CSBlur eases the displayed field by this
float _EmaWeight;  // progressive gather blend weight (samplesPerFrame/totalSamples), from C#
// Coarse grid mapping for CSInitFineFromCoarse (that dispatch's _BgiGrid* uniforms are the FINE grid).
float3 _CoarseGridOrigin;
float3 _CoarseGridVoxelSize;
float _GiFireflyClamp;
float3 _DirectLightDir;   // toward the light
float4 _DirectLightColor;
// Environment lighting as L2 SH from Unity's ambient probe (which already reflects the Lighting
// window's Environment Source = Skybox / Gradient / Color). Evaluated per escaped-ray direction.
// Packed like Unity's unity_SH* / ShadeSH9.
float4 _EnvShAr; float4 _EnvShAg; float4 _EnvShAb; // L0 + L1
float4 _EnvShBr; float4 _EnvShBg; float4 _EnvShBb; // L2 (xy, yz, zz*3, zx)
float4 _EnvShC;                                    // L2 (x^2 - y^2), per channel
float3 _AmbientFloor; // constant indirect fill so shadowed/enclosed air is never pure black
uint   _PointLightCount;
float4 _PointLightPositionRange[MAX_POINT_LIGHTS];
float4 _PointLightColor[MAX_POINT_LIGHTS];
uint   _SpotLightCount;
float4 _SpotLightPositionRange[MAX_SPOT_LIGHTS];
float4 _SpotLightDirectionAngleScale[MAX_SPOT_LIGHTS];
float4 _SpotLightColorAngleOffset[MAX_SPOT_LIGHTS];

// Worst-case ray reach: the volume's world-space diagonal.
#define BGI_MAX_RAY_DIST (length(_BgiGridSize))
// Worst-case DDA step count: a ray crosses at most BGI_GRID cells per axis, so 3*BGI_GRID steps cover
// the whole grid corner-to-corner. This depends only on the resolution (not voxel size/aspect), so it
// is a compile-time constant rather than a uniform.
#define BGI_MAX_RAY_STEPS (BGI_GRID * 3u)

// Procedural stochastic sample (replaces the blue-noise texture, keeps the system textureless):
// per-voxel spatial decorrelation via a hash, animated over frames by the R2 low-discrepancy
// sequence (Cranley-Patterson rotation) so each voxel's sequence converges low-discrepancy.
float2 GiSampleNoise(uint3 id, uint frame, uint salt)
{
    uint seed = (id.x * 73856093u) ^ (id.y * 19349663u) ^ (id.z * 83492791u) ^ (salt * 2654435761u);
    float2 base = float2(HashTo01(seed), HashTo01(seed ^ 0x9e3779b9u));
    float2 r2 = frac(float(frame) * float2(0.7548776662, 0.5698402909));
    return frac(base + r2);
}

// ----------------------------------------------------------
// 3D-DDA (Amanatides-Woo) through the occupancy buffer. The world-space ray direction is mapped
// into grid space (divide by per-axis voxel size) so the cell walk is correct for non-cubic
// voxels; because the world dir is unit length the marched t comes out in WORLD units, so
// maxDist is a world distance (light distance / volume diagonal). Steps off the origin cell first
// (so a voxel never self-occludes), stops at the first solid cell or past maxDist. Returns 1 on a
// solid hit (hitCell valid), else 0.
// ----------------------------------------------------------
int MarchOccupancy(int3 start, float3 worldDir, float maxDist, out int3 hitCell)
{
    hitCell = start;
    int3 cell = start;
    float3 d = worldDir / max(_BgiVoxelSize, 1e-6); // world dir -> grid-space dir
    int3 step = int3(d.x >= 0 ? 1 : -1, d.y >= 0 ? 1 : -1, d.z >= 0 ? 1 : -1);
    float3 inv = 1.0 / max(abs(d), 1e-6);
    float3 tMax = inv * 0.5;   // world distance from cell center to the first boundary on each axis
    float3 tDelta = inv;       // world distance to cross one full voxel on each axis

    [loop]
    for (uint s = 0u; s < BGI_MAX_RAY_STEPS; s++) {
        float tCross;
        if (tMax.x < tMax.y) {
            if (tMax.x < tMax.z) { tCross = tMax.x; cell.x += step.x; tMax.x += tDelta.x; }
            else                 { tCross = tMax.z; cell.z += step.z; tMax.z += tDelta.z; }
        } else {
            if (tMax.y < tMax.z) { tCross = tMax.y; cell.y += step.y; tMax.y += tDelta.y; }
            else                 { tCross = tMax.z; cell.z += step.z; tMax.z += tDelta.z; }
        }
        if (tCross > maxDist) return 0;         // reached the light / max range before a hit
        if (!BgiInBounds(cell)) return 0;       // escaped the grid -> sky/miss
        if (BgiIsSolid(_Material[BgiSlot((uint3)cell)])) { hitCell = cell; return 1; }
    }
    return 0;
}

// Surface normal from the occupancy gradient: sum the directions toward empty neighbors. Out-of-grid
// neighbors count as empty (open). Returns 0 when the gradient is AMBIGUOUS - air on opposite sides
// (a 1-voxel-thick wall) or a fully-enclosed interior, where no single outward face exists. Callers
// must handle 0: the gather rejects such a hit (-> ambient floor, so a thin wall can't leak its
// room-lit front value to air trapped behind it); inject falls back to up.
float3 OccupancyNormal(int3 c)
{
    const int3 axes[6] = {
        int3(1,0,0), int3(-1,0,0), int3(0,1,0), int3(0,-1,0), int3(0,0,1), int3(0,0,-1)
    };
    float3 n = 0;
    [unroll]
    for (int i = 0; i < 6; i++) {
        int3 nb = c + axes[i];
        bool solid = BgiInBounds(nb) && BgiIsSolid(_Material[BgiSlot((uint3)nb)]);
        if (!solid) n += (float3)axes[i];
    }
    return (dot(n, n) > 1e-6) ? normalize(n) : float3(0, 0, 0);
}

// Evaluate the environment ambient-probe SH in a direction (matches Unity's ShadeSH9).
float3 EvalEnvSH(float3 n)
{
    float4 vA = float4(n, 1.0);
    float3 l = float3(dot(_EnvShAr, vA), dot(_EnvShAg, vA), dot(_EnvShAb, vA)); // L0 + L1
    float4 vB = n.xyzz * n.yzzx;
    l += float3(dot(_EnvShBr, vB), dot(_EnvShBg, vB), dot(_EnvShBb, vB));       // L2 (4 of 5)
    l += _EnvShC.rgb * (n.x * n.x - n.y * n.y);                                 // L2 (5th)
    return max(0.0, l);
}

// Environment radiance for a ray that escaped to "sky": the ambient-probe SH in that direction plus
// a broad sun lobe (the directional sun is separate from the low-frequency probe).
float3 GetIndirectSkyLight(float3 rayDir)
{
    float sunLobe = saturate(dot(rayDir, _DirectLightDir));
    return EvalEnvSH(rayDir) + _DirectLightColor.rgb * (sunLobe * sunLobe);
}

float3 ClampFirefly(float3 color, float maxLuminance)
{
    // Single return point (an early return lowers to a return-slot variable that the WebGPU
    // validator flags as possibly uninitialized).
    float luma = GetRec709Luminance(color);
    float scale = (maxLuminance > 0.0 && luma > maxLuminance) ? (maxLuminance / max(luma, 1e-6)) : 1.0;
    return color * scale;
}

// Keep the fields finite and non-negative. (c < 1e8) is false for both +Inf and NaN, so they map
// to 0 without isnan() - which fast-math / d3d11 /Gis may strip, defeating the guard. This stops a
// poisoned voxel from spreading through the bounce + blur and rendering black; it recovers next frame.
float3 SanitizeColor(float3 c)
{
    return (c < 1e8) ? clamp(c, 0.0, 60000.0) : float3(0.0, 0.0, 0.0);
}

float GetLocalLightRangeAttenuation(float distSq, float rangeSq)
{
    float distanceAtten = rcp(max(distSq, 0.01));
    float rangeFade = saturate(1.0 - (distSq / max(rangeSq, 1e-6)));
    return distanceAtten * rangeFade * rangeFade;
}

// Direct lighting at a surface voxel, with DDA shadow rays and an N.L cosine term.
float3 GetDirectLight(int3 cell, float3 normal)
{
    float3 voxelCenter = BgiVoxelCenter((uint3)cell);
    int3 hit;

    // Sun
    float3 total = 0;
    float ndlSun = saturate(dot(normal, _DirectLightDir));
    if (ndlSun > 0.0) {
        float vis = MarchOccupancy(cell, _DirectLightDir, BGI_MAX_RAY_DIST, hit) ? 0.0 : 1.0;
        total += _DirectLightColor.rgb * (ndlSun * vis);
    }

    // Point lights
    uint pc = min(_PointLightCount, (uint)MAX_POINT_LIGHTS);
    [loop]
    for (uint p = 0u; p < pc; p++) {
        float4 posRange = _PointLightPositionRange[p];
        float3 toLight = posRange.xyz - voxelCenter;
        float distSq = dot(toLight, toLight);
        float rangeSq = posRange.w * posRange.w;
        if (distSq <= 1e-6 || distSq >= rangeSq) continue;
        float invD = rsqrt(distSq);
        float3 L = toLight * invD;
        float ndl = saturate(dot(normal, L));
        if (ndl <= 0.0) continue;
        float worldDist = distSq * invD; // = sqrt(distSq), distance to the light
        float vis = MarchOccupancy(cell, L, worldDist, hit) ? 0.0 : 1.0;
        total += _PointLightColor[p].rgb * (ndl * vis * GetLocalLightRangeAttenuation(distSq, rangeSq));
    }

    // Spot lights
    uint sc = min(_SpotLightCount, (uint)MAX_SPOT_LIGHTS);
    [loop]
    for (uint sIdx = 0u; sIdx < sc; sIdx++) {
        float4 posRange = _SpotLightPositionRange[sIdx];
        float3 toLight = posRange.xyz - voxelCenter;
        float distSq = dot(toLight, toLight);
        float rangeSq = posRange.w * posRange.w;
        if (distSq <= 1e-6 || distSq >= rangeSq) continue;
        float invD = rsqrt(distSq);
        float3 L = toLight * invD;
        float ndl = saturate(dot(normal, L));
        if (ndl <= 0.0) continue;
        float4 dirAngleScale = _SpotLightDirectionAngleScale[sIdx];
        float4 colAngleOffset = _SpotLightColorAngleOffset[sIdx];
        float cone = saturate(dot(-L, dirAngleScale.xyz) * dirAngleScale.w + colAngleOffset.a);
        if (cone <= 0.0) continue;
        float worldDist = distSq * invD; // = sqrt(distSq), distance to the light
        float vis = MarchOccupancy(cell, L, worldDist, hit) ? 0.0 : 1.0;
        total += colAngleOffset.rgb * (ndl * vis * (cone * cone) * GetLocalLightRangeAttenuation(distSq, rangeSq));
    }

    return total;
}

// One gather ray's contribution from `fromCell` in world direction `dir`: the room-lit radiance of
// the surface it hits (if it crossed that surface's FRONT/lit face), the ambient-floor "interior
// color" for a back-face hit, or the environment sky if the ray escapes the grid. Shared by the air
// probe (omnidirectional) and the surface incident gather (front hemisphere).
//
// Front/back is decided by the hit voxel's occupancy normal. A THIN SLAB with air on BOTH sides
// (a 1-voxel floor/ceiling/wall) has an AMBIGUOUS (zero) occupancy normal; inject computed its
// radiance with an UP fallback normal, so we test against UP here too for consistency: a ray
// arriving from above (dot(dir,up) < 0 = it crossed the lit top face) reads the radiance, while the
// dark underside and horizontally-hit thin vertical walls (dot(dir,up) ~ 0) stay rejected -> ambient
// floor (still blocks the thin-wall leak this originally guarded). Without this, a thin SUNLIT FLOOR
// emits bright radiance but contributes NOTHING to the air above it (bright floor, black irradiance).
float3 GatherRayRadiance(int3 fromCell, float3 dir)
{
    int3 hit;
    float3 result;
    if (MarchOccupancy(fromCell, dir, BGI_MAX_RAY_DIST, hit)) {
        float3 hitNormal = OccupancyNormal(hit);
        float3 faceN = (dot(hitNormal, hitNormal) > 1e-6) ? hitNormal : float3(0, 1, 0); // ambiguous -> up (matches inject)
        if (dot(dir, faceN) < 0.0) {
            float3 rad; float w;
            BgiUnpackRgb(_Radiance[BgiSlot((uint3)hit)], rad, w);
            result = ClampFirefly(rad, _GiFireflyClamp);
        } else {
            result = _AmbientFloor;
        }
    } else {
        result = GetIndirectSkyLight(dir);
    }
    return result;
}

[numthreads(64, 1, 1)]
void CSClear(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= BGI_COUNT) return;
    _Radiance[_FieldOffset + i] = uint2(0u, 0u);
    _Irradiance[_FieldOffset + i] = uint2(0u, 0u);
    _IrradianceBlur[_FieldOffset + i] = uint2(0u, 0u);
}

// ----------------------------------------------------------
// INJECT: outgoing radiance for solid voxels.
// ----------------------------------------------------------
[numthreads(64, 1, 1)]
void CSInject(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= BGI_COUNT) return;

    uint mat = _Material[_FieldOffset + i];
    if (!BgiIsSolid(mat)) { _Radiance[_FieldOffset + i] = uint2(0u, 0u); return; }

    int3 cell = (int3)BgiCoord(i);
    float3 normal = OccupancyNormal(cell);
    if (dot(normal, normal) < 1e-6) normal = float3(0, 1, 0); // ambiguous -> harmless up for direct/bounce
    float3 albedo = BgiAlbedo(mat);
    float emissionIntensity = DecodeEmissionIntensityFrom8Bit(BgiEmission8(mat));
    float3 emissive = albedo * emissionIntensity;

    // Bounce arriving at this surface = its incident irradiance, gathered over the FRONT hemisphere
    // by CSGather (previous frame) and stored in this solid voxel's own _Irradiance slot. Reading
    // that - instead of the adjacent AIR voxel's OMNIDIRECTIONAL probe - means the surface no longer
    // sees its own outgoing radiance (that probe's back hemisphere is this very wall), which was an
    // F_ii self-illumination loop: energy the wall emits came back as "incident" and re-lit it. It
    // also restores directionality, so light from an opening propagates inward instead of averaging
    // flat against dark neighbours (helps cavern/indirect fill).
    float3 bounce; float bw;
    BgiUnpackRgb(_Irradiance[_FieldOffset + i], bounce, bw);

    // Clamp reflectance below 1: with albedo == 1 the bounce feedback is a lossless cavity that
    // diverges to Inf/NaN ("black plague"). Still cheap insurance for concave corners even though the
    // front-hemisphere gather removed the dominant self-term. Emission is unaffected (added separately).
    float3 safeAlbedo = min(albedo, 0.95);
    float3 direct = GetDirectLight(cell, normal);
    float3 outgoing = SanitizeColor(emissive + safeAlbedo * (direct + bounce));
    _Radiance[_FieldOffset + i] = BgiPackRgb(outgoing, 1.0);
}

// ----------------------------------------------------------
// GATHER: 1+ rays/frame per voxel, with the temporal resolve fused in (in-place EMA). Two roles by
// occupancy: AIR voxels build the OMNIDIRECTIONAL irradiance probe the fragment read samples; SOLID
// (surface) voxels build their INCIDENT irradiance over the FRONT hemisphere (cosine-weighted around
// the surface normal), stored in the same buffer slot and read by CSInject as the surface's `bounce`.
// The surface gather runs here (not in CSInject) so it reads this frame's _Radiance from a completed
// dispatch rather than racing the same one.
// ----------------------------------------------------------
[numthreads(64, 1, 1)]
void CSGather(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= BGI_COUNT) return;

    uint3 c = BgiCoord(i);
    int3 cell = (int3)c;
    bool solid = BgiIsSolid(_Material[_FieldOffset + i]);

    // For a solid voxel, gather rays into the front hemisphere around the surface normal (so they
    // leave the surface into the room and never read it back). Ambiguous normal -> up, matching inject.
    float3 normal = float3(0, 1, 0);
    if (solid) {
        normal = OccupancyNormal(cell);
        if (dot(normal, normal) < 1e-6) normal = float3(0, 1, 0);
    }

    float3 incoming = 0;
    uint sampleCount = max(_SamplesPerFrame, 1u);
    [loop]
    for (uint r = 0u; r < sampleCount; r++) {
        float2 noise = GiSampleNoise(c, _FrameCount, r);
        float3 dir = solid ? CosineSampleHemisphere(normal, noise) // surface: front hemisphere
                           : GetRandomDirectionFromNoise2(noise);  // air: omnidirectional probe
        incoming += GatherRayRadiance(cell, dir);
    }
    incoming *= rcp((float)sampleCount); // this frame's estimate = mean of sampleCount samples

    // Temporal PROGRESSIVE average: fold this frame's sampleCount-ray estimate into the running mean of
    // all rays gathered so far, weight = sampleCount/totalSamples (_EmaWeight from C#). The field
    // ACCUMULATES so variance ~1/totalSamples -> it keeps getting cleaner and converges (not a fixed
    // window that shimmers forever). The first frame is ~weight 1 (noisy), but CSBlur's Confidence≈0
    // hides that warm-up. No per-voxel count stored (packed 4th channel = 0).
    float3 oldC; float oldN;
    BgiUnpackRgb(_Irradiance[_FieldOffset + i], oldC, oldN); // oldN unused
    float weight = min(1.0, _EmaWeight);
    float3 newC = SanitizeColor(lerp(oldC, incoming, weight));
    _Irradiance[_FieldOffset + i] = BgiPackRgb(newC, 0.0);
}

// ----------------------------------------------------------
// BLUR: occupancy-gated box blur of the air-voxel irradiance into _IrradianceBlur (what the fragment
// read samples). Gating skips solid neighbors so dark/zero solid voxels and across-wall values can't
// bleed in. Averaging decorrelated neighbours hides the 1-ray/frame temporal shimmer. The result is
// then eased toward from the PREVIOUS _IrradianceBlur by _Confidence (0 at a light change -> 1 when
// converged), so the displayed field transitions smoothly and only fully lands once GI has converged.
// ----------------------------------------------------------
[numthreads(64, 1, 1)]
void CSBlur(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= BGI_COUNT) return;

    if (BgiIsSolid(_Material[_FieldOffset + i])) { _IrradianceBlur[_FieldOffset + i] = uint2(0u, 0u); return; }

    int3 c = (int3)BgiCoord(i);
    float3 sum; float count;
    BgiUnpackRgb(_Irradiance[_FieldOffset + i], sum, count); // center
    float wsum = 1.0;

    const int3 axes[6] = {
        int3(1,0,0), int3(-1,0,0), int3(0,1,0), int3(0,-1,0), int3(0,0,1), int3(0,0,-1)
    };
    [unroll]
    for (int k = 0; k < 6; k++) {
        int3 nb = c + axes[k];
        if (!BgiInBounds(nb)) continue;
        if (BgiIsSolid(_Material[BgiSlot((uint3)nb)])) continue; // gate: don't blur across surfaces
        float3 nc; float nn;
        BgiUnpackRgb(_Irradiance[BgiSlot((uint3)nb)], nc, nn);
        sum += nc;
        wsum += 1.0;
    }

    // Ease the displayed value from its previous state toward the freshly-blurred one by confidence,
    // so a light change fades in and completes exactly when the field has converged (confidence == 1).
    float3 blurred = sum / wsum;
    float3 prevBlur; float pw;
    BgiUnpackRgb(_IrradianceBlur[_FieldOffset + i], prevBlur, pw);
    _IrradianceBlur[_FieldOffset + i] = BgiPackRgb(lerp(prevBlur, blurred, _Confidence), 0.0);
}

// ----------------------------------------------------------
// INIT FINE FROM COARSE: seed a freshly-switched fine field with the coarse field's DISPLAYED value
// (its _IrradianceBlur) so the fine box starts from the coarse approximation instead of black, then
// refines as the fine gather re-converges (the CSBlur confidence ease departs from this seed). The
// dispatch's _BgiGrid* uniforms are the FINE grid; _CoarseGrid* map into the coarse field.
// ----------------------------------------------------------
[numthreads(64, 1, 1)]
void CSInitFineFromCoarse(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= BGI_COUNT) return;

    uint fineSlot = BGI_FINE_OFFSET + i;
    _Radiance[fineSlot] = uint2(0u, 0u);
    if (BgiIsSolid(_Material[fineSlot])) { // irradiance lives only in air voxels
        _Irradiance[fineSlot] = uint2(0u, 0u);
        _IrradianceBlur[fineSlot] = uint2(0u, 0u);
        return;
    }

    // Coarse cell containing this fine voxel's world center.
    float3 world = BgiVoxelCenter(BgiCoord(i));
    int3 cc = (int3)floor(BgiWorldToGridAt(world, _CoarseGridOrigin, _CoarseGridVoxelSize));

    // Displayed coarse value there. Coarse voxels are big, so a fine air voxel near geometry can land
    // in a SOLID coarse cell (zero) - fall back to the average of that cell's air neighbours so
    // near-surface seeds aren't black.
    float3 seed = 0;
    if (BgiInBounds(cc)) {
        uint coarseSlot = BGI_COARSE_OFFSET + BgiIndex((uint3)cc);
        if (!BgiIsSolid(_Material[coarseSlot])) {
            float w;
            BgiUnpackRgb(_IrradianceBlur[coarseSlot], seed, w);
        } else {
            const int3 axes[6] = {
                int3(1,0,0), int3(-1,0,0), int3(0,1,0), int3(0,-1,0), int3(0,0,1), int3(0,0,-1)
            };
            float wsum = 0.0;
            [unroll]
            for (int k = 0; k < 6; k++) {
                int3 nb = cc + axes[k];
                if (!BgiInBounds(nb)) continue;
                uint nbSlot = BGI_COARSE_OFFSET + BgiIndex((uint3)nb);
                if (BgiIsSolid(_Material[nbSlot])) continue;
                float3 c; float w;
                BgiUnpackRgb(_IrradianceBlur[nbSlot], c, w);
                seed += c;
                wsum += 1.0;
            }
            seed = (wsum > 0.0) ? seed / wsum : 0.0;
        }
    }

    // Seed both: the blur is the displayed start value (the confidence ease departs from it), and the
    // raw irradiance keeps the first inject's bounce read consistent with it.
    uint2 packed = BgiPackRgb(seed, 0.0);
    _Irradiance[fineSlot] = packed;
    _IrradianceBlur[fineSlot] = packed;
}
