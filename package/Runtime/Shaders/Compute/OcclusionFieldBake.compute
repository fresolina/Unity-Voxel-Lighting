#pragma kernel CSMain
#pragma target 5.0

#include "../Includes/Math.hlsl"
#include "../Includes/Raymarch.hlsl"

// SDF volume
Texture3D<float> _SdfTex;
SamplerState sampler_SdfTex;

// Bounds
float3 _BoundsMin;
float3 _BoundsSize;
uint3 _Resolution;

// Raymarching parameters
float _ShadowSoftness;
int _SdfMaxSteps;
float _SdfMinStep;
float _SdfThicknessTol;

// 4 Fibonacci directions for this batch (one per RGBA channel)
StructuredBuffer<float3> _FibonacciDirs;

// Output: 4 floats per voxel (R, G, B, A = directions 0, 1, 2, 3 of this batch)
RWStructuredBuffer<float> _OutOcclusion;

[numthreads(8, 8, 8)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= _Resolution))
        return;

    float3 voxelSize = _BoundsSize / float3(_Resolution);
    float3 voxelCenter = _BoundsMin + (float3(id) + 0.5) * voxelSize;
    float voxelDiag = length(voxelSize);
    float originBias = max(_SdfMinStep * 0.5, voxelDiag * 0.01);
    // Sun shadows need full-volume traversal; the bounds diagonal is the max possible distance.
    float maxDistance = length(_BoundsSize);

    uint flatIdx = id.x + id.y * _Resolution.x + id.z * _Resolution.x * _Resolution.y;
    uint baseOut = flatIdx * 4;

    // Raymarch each of the 4 directions and store the lit value
    [unroll]
    for (uint c = 0; c < 4; c++)
    {
        float3 rayDir = _FibonacciDirs[c];
        float lit = RayMarchTex3D(
            _SdfTex, sampler_SdfTex,
            voxelCenter, rayDir,
            _BoundsMin, _BoundsSize,
            originBias, maxDistance,
            _SdfThicknessTol, _SdfMinStep,
            _SdfMaxSteps, _ShadowSoftness
        );
        _OutOcclusion[baseOut + c] = lit;
    }
}
