#pragma kernel CSMain
#pragma target 5.0

#include "OcclusionBakeCommon.hlsl"

// Soft shadow penumbra factor
float _RaymarchSoftness;

// Output: dirCount floats per voxel (1 for single-direction, 4 for multi-direction batches)
RWStructuredBuffer<float> _OutOcclusion;

[numthreads(8, 8, 8)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= _Resolution))
        return;

    float3 voxelCenter;
    float originBias, maxDistance;
    ComputeVoxelParams(id, voxelCenter, originBias, maxDistance);

    uint dirCount, dirStride;
    _Directions.GetDimensions(dirCount, dirStride);

    uint flatIdx = id.x + id.y * _Resolution.x + id.z * _Resolution.x * _Resolution.y;
    uint baseOut = flatIdx * dirCount;

    for (uint c = 0; c < dirCount; c++)
    {
        float3 rayDir = _Directions[c];
        float lit = RayMarchTex3D(
            _SdfHires, sampler_SdfHires,
            voxelCenter, rayDir,
            _BoundsMin, _BoundsSize,
            originBias, maxDistance,
            _RaymarchEpsilon, _RaymarchMinStep,
            _RaymarchMaxSteps, _RaymarchSoftness
        );
        _OutOcclusion[baseOut + c] = lit;
    }
}
