#pragma kernel CSMain
#pragma target 5.0

#include "OcclusionBakeCommon.hlsl"

// Soft shadow penumbra factor
float _ShadowSoftness;

// Output: 4 floats per voxel (R, G, B, A = directions 0, 1, 2, 3 of this batch)
RWStructuredBuffer<float> _OutOcclusion;

[numthreads(8, 8, 8)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= _Resolution))
        return;

    float3 voxelCenter;
    float originBias, maxDistance;
    ComputeVoxelParams(id, voxelCenter, originBias, maxDistance);

    uint flatIdx = id.x + id.y * _Resolution.x + id.z * _Resolution.x * _Resolution.y;
    uint baseOut = flatIdx * 4;

    [unroll]
    for (uint c = 0; c < 4; c++)
    {
        float3 rayDir = _FibonacciDirs[c];
        float lit = RayMarchTex3D(
            _SdfTex, sampler_SdfTex,
            voxelCenter, rayDir,
            _BoundsMin, _BoundsSize,
            originBias, maxDistance,
            _SdfThicknessTol, _SdfMinStep,
            _SdfMaxSteps, _ShadowSoftness
        );
        _OutOcclusion[baseOut + c] = lit;
    }
}
