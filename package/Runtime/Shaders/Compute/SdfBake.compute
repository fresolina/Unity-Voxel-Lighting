#pragma kernel CSMain
#pragma target 5.0

#include "../Includes/Math.hlsl"

// 3D SDF Bake from triangles

// Inputs
StructuredBuffer<float3> _TriVerts; // 3 float3 per triangle
float3 _BoundsMin;
float3 _BoundsSize;
int3 _Resolution;

// Uniform-grid acceleration structure (built on the CPU, see SdfBaker.cs).
// The grid lets each voxel test only triangles in nearby cells instead of the
// whole mesh. It produces the exact same nearest triangle as a brute-force scan
// (an expanding shell search only skips cells that provably cannot be closer),
// so the baked distance and sign are identical - just far cheaper.
StructuredBuffer<uint> _CellStart;  // _CellCount + 1 prefix-sum offsets (CSR)
StructuredBuffer<uint> _TriIndices; // triangle indices grouped by cell
int3 _GridDim;                      // grid cell counts per axis
float _CellSize;                    // cubic cell edge length, world units

// Output
// NOTE: Using `half` in UAV buffers is not guaranteed to be 16-bit on all backends.
// Pack explicitly to 16-bit half bits via f32tof16 and store in a uint.
RWStructuredBuffer<uint> _OutSdf; // lower 16 bits contain IEEE-754 half bits

static const float EPS = 1e-7;

bool PointProjectedInsideTriangle(float3 p, float3 a, float3 b, float3 c, float3 triNormal) {
    float3 edge0 = b - a;
    float3 edge1 = c - b;
    float3 edge2 = a - c;

    float side0 = dot(triNormal, cross(edge0, p - a));
    float side1 = dot(triNormal, cross(edge1, p - b));
    float side2 = dot(triNormal, cross(edge2, p - c));

    return side0 >= -EPS && side1 >= -EPS && side2 >= -EPS;
}

bool IsInsideVirtualBackfaceExtrusion(float3 p, float3 a, float3 b, float3 c, float extrusionDistance) {
    float3 triNormal = cross(b - a, c - a);
    float normalLenSq = dot(triNormal, triNormal);
    if (normalLenSq <= EPS)
        return false;

    float3 normal = triNormal * rsqrt(normalLenSq);
    float3 closestPoint = ClosestPointOnTriangle(p, a, b, c);
    float3 closestOffset = p - closestPoint;

    if (dot(closestOffset, closestOffset) > extrusionDistance * extrusionDistance)
        return false;

    float signedDistance = dot(normal, closestOffset);
    if (signedDistance > 0.0 || signedDistance < -extrusionDistance)
        return false;

    float3 projectedPoint = p - signedDistance * normal;
    return PointProjectedInsideTriangle(projectedPoint, a, b, c, triNormal);
}

float PointTriangleDistanceSq(float3 p, float3 a, float3 b, float3 c) {
    float3 ab = b - a;
    float3 ac = c - a;
    float3 ap = p - a;

    float d1 = dot(ab, ap);
    float d2 = dot(ac, ap);
    if (d1 <= 0.0 && d2 <= 0.0) return dot(ap, ap);

    float3 bp = p - b;
    float d3 = dot(ab, bp);
    float d4 = dot(ac, bp);
    if (d3 >= 0.0 && d4 <= d3) return dot(bp, bp);

    float vc = d1 * d4 - d3 * d2;
    if (vc <= 0.0 && d1 >= 0.0 && d3 <= 0.0) {
        float v = d1 / max(d1 - d3, EPS);
        float3 q = a + v * ab;
        float3 d = p - q;
        return dot(d, d);
    }

    float3 cp = p - c;
    float d5 = dot(ab, cp);
    float d6 = dot(ac, cp);
    if (d6 >= 0.0 && d5 <= d6) return dot(cp, cp);

    float vb = d5 * d2 - d1 * d6;
    if (vb <= 0.0 && d2 >= 0.0 && d6 <= 0.0) {
        float w = d2 / max(d2 - d6, EPS);
        float3 q = a + w * ac;
        float3 d = p - q;
        return dot(d, d);
    }

    float va = d3 * d6 - d5 * d4;
    if (va <= 0.0 && (d4 - d3) >= 0.0 && (d5 - d6) >= 0.0) {
        float w = (d4 - d3) / max((d4 - d3) + (d5 - d6), EPS);
        float3 q = b + w * (c - b);
        float3 d = p - q;
        return dot(d, d);
    }

    float3 n = cross(ab, ac);
    float invLenSq = 1.0 / max(dot(n, n), EPS);
    float dist = dot(ap, n);
    return (dist * dist) * invLenSq;
}

// Tests every triangle registered in one grid cell against point p, keeping the
// nearest. No-op when the cell is outside the grid. Cells may share a triangle, so
// a triangle can be retested across cells - harmless, it only affects the minimum.
void ScanCell(int3 cell, float3 p, inout float minDistSq, inout int bestTri) {
    if (any(cell < 0) || any(cell >= _GridDim))
        return;

    int cellIndex = cell.x + cell.y * _GridDim.x + cell.z * _GridDim.x * _GridDim.y;
    uint start = _CellStart[cellIndex];
    uint end = _CellStart[cellIndex + 1];

    for (uint k = start; k < end; k++) {
        int tri = (int)_TriIndices[k];
        int baseIndex = tri * 3;
        float3 a = _TriVerts[baseIndex + 0];
        float3 b = _TriVerts[baseIndex + 1];
        float3 c = _TriVerts[baseIndex + 2];

        float d2 = PointTriangleDistanceSq(p, a, b, c);
        if (d2 < minDistSq) {
            minDistSq = d2;
            bestTri = tri;
        }
    }
}

[numthreads(4, 4, 4)]
void CSMain(uint3 id : SV_DispatchThreadID) {
    if (id.x >= (uint)_Resolution.x || id.y >= (uint)_Resolution.y || id.z >= (uint)_Resolution.z)
        return;

    float3 size = max(_BoundsSize, 1e-6);

    float3 uvw = (float3(id) + 0.5) / float3(_Resolution);
    float3 p = _BoundsMin + uvw * size;

    float minDistSq = 1e30;
    int bestTri = 0;
    float backfaceExtrusionDistance = length(size / max(float3(_Resolution), 1.0));

    // Cell containing p, then search outward in Chebyshev shells. A triangle whose
    // nearest point is within distance d has its AABB - and therefore a grid
    // registration - in a cell within d of p, so once the closest possible point of
    // the next shell is farther than the best distance found, no closer triangle can
    // remain. lowerBound = (r - 1) * cellSize is the exact minimum distance from p to
    // any cell in shell r, making the early-out conservative and the result exact.
    int3 home = clamp(int3(floor((p - _BoundsMin) / _CellSize)), int3(0, 0, 0), _GridDim - int3(1, 1, 1));
    int maxRadius = max(_GridDim.x, max(_GridDim.y, _GridDim.z));

    [loop]
    for (int r = 0; r <= maxRadius; r++) {
        if (r > 0) {
            float lowerBound = (r - 1) * _CellSize;
            if (lowerBound * lowerBound >= minDistSq)
                break;
        }

        int3 lo = home - r;
        int3 hi = home + r;

        // Visit only the shell at Chebyshev distance r: full rows on the z/y faces,
        // and just the two x endpoints on interior rows.
        for (int z = lo.z; z <= hi.z; z++) {
            bool zFace = (z == lo.z || z == hi.z);
            for (int y = lo.y; y <= hi.y; y++) {
                bool yFace = (y == lo.y || y == hi.y);
                if (zFace || yFace) {
                    for (int x = lo.x; x <= hi.x; x++)
                        ScanCell(int3(x, y, z), p, minDistSq, bestTri);
                } else {
                    ScanCell(int3(lo.x, y, z), p, minDistSq, bestTri);
                    if (hi.x != lo.x)
                        ScanCell(int3(hi.x, y, z), p, minDistSq, bestTri);
                }
            }
        }
    }

    float dist = sqrt(max(minDistSq, 0.0));
    int bestBase = bestTri * 3;
    float3 bestA = _TriVerts[bestBase + 0];
    float3 bestB = _TriVerts[bestBase + 1];
    float3 bestC = _TriVerts[bestBase + 2];
    bool inside = IsInsideVirtualBackfaceExtrusion(p, bestA, bestB, bestC, backfaceExtrusionDistance);
    float sdf = inside ? -dist : dist;

    int idx = (int)id.x + (int)id.y * _Resolution.x + (int)id.z * _Resolution.x * _Resolution.y;
    uint packed = f32tof16(sdf);
    _OutSdf[idx] = packed;
}
