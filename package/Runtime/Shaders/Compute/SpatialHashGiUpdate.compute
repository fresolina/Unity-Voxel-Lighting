// Surface-Based Spatial Hash Voxel GI - Compute Shader
// Kernels: clear hash grid, voxelize surfaces from SDF, inject light per surface voxel.

#pragma kernel CSClearHashGrid
#pragma kernel CSVoxelizeSurfaces
#pragma kernel CSInjectLight

#define SPATIAL_HASH_GRID_SIZE 64
#define SPATIAL_HASH_GRID_TOTAL (SPATIAL_HASH_GRID_SIZE * SPATIAL_HASH_GRID_SIZE * SPATIAL_HASH_GRID_SIZE)
#define MAX_SDF_DIST 1.0e+10
#define MAX_POINT_LIGHTS 4
#define MAX_SPOT_LIGHTS 4

#include "../Includes/Volume.hlsl"
#include "../Includes/Raymarch.hlsl"

// --- GI RAYMARCHING (same constants as VoxelGiUpdate.compute) ---
#define EPSILON (_VoxelSize.x * 0.25)
#define RAYMARCH_MIN_STEP (_VoxelSize.x * 0.0625)

int _RaymarchMaxSteps;
float _RaymarchSoftness;

float ComputeRaymarchStartOffset(float dist)
{
    return max(0.0, (EPSILON + RAYMARCH_MIN_STEP) - dist);
}

float RaymarchSDF(float3 voxelCenter, float3 rayDir, float startOffset, float maxDistance, out float3 hitPos)
{
    return RayMarchTex3D(_DistanceField, linearClampSampler, voxelCenter, rayDir, _VolumePosition, _VolumeSize, startOffset, maxDistance, EPSILON, RAYMARCH_MIN_STEP, _RaymarchMaxSteps, _RaymarchSoftness, hitPos);
}

// --- VoxelGI struct (mirrors SpatialHashGi.hlsl) ---

struct VoxelGI
{
    uint voxelPackedPos;
    uint colorAmbient;
    uint colorModifiers;
};

inline uint PackPosition10(uint3 pos)
{
    return (pos.x & 0x3FF) | ((pos.y & 0x3FF) << 10) | ((pos.z & 0x3FF) << 20);
}

inline uint3 UnpackPosition10(uint packed)
{
    return uint3(packed & 0x3FF, (packed >> 10) & 0x3FF, (packed >> 20) & 0x3FF);
}

inline uint PackR8G8B8A8(float4 color)
{
    uint r = (uint)(saturate(color.r) * 255.0);
    uint g = (uint)(saturate(color.g) * 255.0);
    uint b = (uint)(saturate(color.b) * 255.0);
    uint a = (uint)(saturate(color.a) * 255.0);
    return (r << 24) | (g << 16) | (b << 8) | a;
}

inline float4 UnpackR8G8B8A8(uint packed)
{
    float r = ((packed >> 24) & 0xFF) / 255.0;
    float g = ((packed >> 16) & 0xFF) / 255.0;
    float b = ((packed >> 8) & 0xFF) / 255.0;
    float a = (packed & 0xFF) / 255.0;
    return float4(r, g, b, a);
}

inline int SpatialHashLinearIndex(uint3 voxelPos)
{
    return (int)(voxelPos.x + (voxelPos.y * SPATIAL_HASH_GRID_SIZE) + (voxelPos.z * SPATIAL_HASH_GRID_SIZE * SPATIAL_HASH_GRID_SIZE));
}

// --- BUFFERS ---

RWStructuredBuffer<VoxelGI> _VoxelDataBuffer;
RWStructuredBuffer<int> _VoxelHashGrid;
RWStructuredBuffer<uint> _VoxelCounter; // [0] = active voxel count

// Read-only material and SDF
Texture3D<float4> _MaterialAlbedoIntensity;

// --- UNIFORMS ---
float _SpatialHashVoxelSize;
uint _MaxVoxelCount;
uint _ActiveVoxelCount;

// Lighting
float3 _DirectLightDir;
float4 _DirectLightColor;
float3 _SkyColor;
uint _PointLightCount;
float4 _PointLightPositionRange[MAX_POINT_LIGHTS];
float4 _PointLightColor[MAX_POINT_LIGHTS];
uint _SpotLightCount;
float4 _SpotLightPositionRange[MAX_SPOT_LIGHTS];
float4 _SpotLightDirectionAngleScale[MAX_SPOT_LIGHTS];
float4 _SpotLightColorAngleOffset[MAX_SPOT_LIGHTS];

// --- Helper: local light range attenuation ---

float GetLocalLightRangeAttenuation(float distSq, float rangeSq)
{
    float distanceAtten = rcp(max(distSq, 0.01));
    float rangeFade = saturate(1.0 - (distSq / max(rangeSq, 1e-6)));
    return distanceAtten * rangeFade * rangeFade;
}

// --- Helper: point / spot light contribution ---

float3 GetPointLight(float3 voxelCenter, float startOffset)
{
    float3 totalLight = 0.0;
    uint pointLightCount = min(_PointLightCount, (uint)MAX_POINT_LIGHTS);

    [loop]
    for (uint i = 0u; i < pointLightCount; i++)
    {
        float4 posRange = _PointLightPositionRange[i];
        float3 toLight = posRange.xyz - voxelCenter;
        float distSq = dot(toLight, toLight);
        float rangeSq = posRange.w * posRange.w;
        if (distSq <= 1e-6 || distSq >= rangeSq) continue;

        float invDist = rsqrt(distSq);
        float dist = distSq * invDist;
        float3 lightDir = toLight * invDist;
        float3 hitPos;
        float vis = RaymarchSDF(voxelCenter, lightDir, startOffset, dist, hitPos);
        float atten = vis * GetLocalLightRangeAttenuation(distSq, rangeSq);
        totalLight += _PointLightColor[i].rgb * atten;
    }
    return totalLight;
}

float3 GetSpotLight(float3 voxelCenter, float startOffset)
{
    float3 totalLight = 0.0;
    uint spotLightCount = min(_SpotLightCount, (uint)MAX_SPOT_LIGHTS);

    [loop]
    for (uint i = 0u; i < spotLightCount; i++)
    {
        float4 posRange = _SpotLightPositionRange[i];
        float3 toLight = posRange.xyz - voxelCenter;
        float distSq = dot(toLight, toLight);
        float rangeSq = posRange.w * posRange.w;
        if (distSq <= 1e-6 || distSq >= rangeSq) continue;

        float invDist = rsqrt(distSq);
        float dist = distSq * invDist;
        float3 lightDir = toLight * invDist;

        float4 dirAngleScale = _SpotLightDirectionAngleScale[i];
        float4 colAngleOffset = _SpotLightColorAngleOffset[i];
        float coneAtten = saturate(dot(-lightDir, dirAngleScale.xyz) * dirAngleScale.w + colAngleOffset.a);
        if (coneAtten <= 0.0) continue;

        float3 hitPos;
        float vis = RaymarchSDF(voxelCenter, lightDir, startOffset, dist, hitPos);
        float atten = vis * GetLocalLightRangeAttenuation(distSq, rangeSq) * (coneAtten * coneAtten);
        totalLight += colAngleOffset.rgb * atten;
    }
    return totalLight;
}

// ============================================================
// KERNEL: Clear Hash Grid
// Fills all hash grid slots with -1 (empty).
// ============================================================
[numthreads(64, 1, 1)]
void CSClearHashGrid(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= (uint)SPATIAL_HASH_GRID_TOTAL) return;
    _VoxelHashGrid[idx] = -1;
}

// ============================================================
// KERNEL: Voxelize Surfaces
// Iterates over the 64^3 hash grid, samples the SDF to find
// near-surface voxels, and populates the data buffer + hash grid.
// ============================================================
[numthreads(4, 4, 4)]
void CSVoxelizeSurfaces(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= uint3(SPATIAL_HASH_GRID_SIZE, SPATIAL_HASH_GRID_SIZE, SPATIAL_HASH_GRID_SIZE)))
        return;

    int linearIndex = SpatialHashLinearIndex(id);

    // Compute world position for the center of this hash cell
    float3 worldPos = _VolumePosition + (float3(id) + 0.5) * _SpatialHashVoxelSize;
    float3 uvw = WorldToVoxelUV(worldPos);

    // Sample SDF at this position
    float dist = _DistanceField.SampleLevel(linearClampSampler, uvw, 0).r;

    // Near-surface check: both interior and exterior surfaces within one voxel
    bool isSurface = abs(dist) < _SpatialHashVoxelSize;
    if (!isSurface)
    {
        _VoxelHashGrid[linearIndex] = -1;
        return;
    }

    // Atomically allocate a slot in the data buffer
    uint dataIndex;
    InterlockedAdd(_VoxelCounter[0], 1u, dataIndex);

    if (dataIndex >= _MaxVoxelCount)
    {
        // Buffer full; mark as empty
        _VoxelHashGrid[linearIndex] = -1;
        return;
    }

    // Pack position and write initial (unlit) entry
    uint packedPos = PackPosition10(id);

    VoxelGI voxel;
    voxel.voxelPackedPos = packedPos;
    voxel.colorAmbient = 0;
    voxel.colorModifiers = PackR8G8B8A8(float4(0.5, 0.5, 0.5, 0.0)); // neutral SH

    _VoxelDataBuffer[dataIndex] = voxel;
    _VoxelHashGrid[linearIndex] = (int)dataIndex;
}

// ============================================================
// KERNEL: Inject Light
// For each active surface voxel, compute direct + indirect lighting
// and encode as L1 SH into the VoxelGI entry.
// ============================================================
[numthreads(64, 1, 1)]
void CSInjectLight(uint3 id : SV_DispatchThreadID)
{
    uint voxelIndex = id.x;
    if (voxelIndex >= _ActiveVoxelCount) return;

    VoxelGI voxel = _VoxelDataBuffer[voxelIndex];

    // Unpack grid position and reconstruct world position
    uint3 gridPos = UnpackPosition10(voxel.voxelPackedPos);
    float3 worldPos = _VolumePosition + (float3(gridPos) + 0.5) * _SpatialHashVoxelSize;
    float3 uvw = WorldToVoxelUV(worldPos);

    // Get SDF distance and surface normal
    float dist = _DistanceField.SampleLevel(pointClampSampler, uvw, 0).r;
    float3 surfaceNormal = GetNormalFromSDF(worldPos);

    // Self-occlusion bias (same as VoxelGiUpdate.compute)
    float startOffset = ComputeRaymarchStartOffset(abs(dist));

    // --- Direct sun lighting ---
    float3 hitPos;
    float sunVisibility = RaymarchSDF(worldPos, _DirectLightDir, startOffset, MAX_SDF_DIST, hitPos);
    float3 sunLight = _DirectLightColor.rgb * sunVisibility;

    // Angle of incidence relative to the sun for directional weighting
    float sunNdotL = saturate(dot(surfaceNormal, _DirectLightDir));

    // --- Local lights ---
    float3 pointLight = GetPointLight(worldPos, startOffset);
    float3 spotLight = GetSpotLight(worldPos, startOffset);

    // --- Sky light ---
    float3 skyLight = _SkyColor;

    // --- Get surface albedo for bounce color ---
    float4 albedoIntensity = _MaterialAlbedoIntensity.SampleLevel(pointClampSampler, uvw, 0);
    float emissionIntensity = DecodeEmissionIntensityFrom8Bit(albedoIntensity.a);
    float3 emissiveLight = albedoIntensity.rgb * emissionIntensity;

    // --- Compute total illumination ---
    float3 directLight = sunLight * sunNdotL + pointLight + spotLight;
    float3 totalLight = (directLight + skyLight) * albedoIntensity.rgb + emissiveLight;

    // --- L1 SH Encoding ---
    // Ambient (DC band): average incoming light
    float3 ambient = totalLight;

    // Directional (L1 bands): weighted by dominant light direction.
    // Sun contributes along its direction proportional to visibility.
    // Local lights contribute along their aggregate direction.
    float3 shDir = _DirectLightDir * sunVisibility * sunNdotL;
    // Scale the SH directional term relative to ambient intensity
    float3 shCoeffs = shDir * length(sunLight) * albedoIntensity.rgb;

    // Bias SH from [-1,1] to [0,1] for R8G8B8A8 packing
    // Normalize SH relative to ambient magnitude to keep within range
    float ambientLum = max(dot(ambient, float3(0.333, 0.334, 0.333)), 1e-6);
    float3 shNormalized = clamp(shCoeffs / ambientLum, -1.0, 1.0);
    float3 shBiased = shNormalized * 0.5 + 0.5;

    // Pack into VoxelGI
    voxel.colorAmbient = PackR8G8B8A8(float4(saturate(ambient), 0.0));
    voxel.colorModifiers = PackR8G8B8A8(float4(saturate(shBiased), 0.0));

    _VoxelDataBuffer[voxelIndex] = voxel;
}
