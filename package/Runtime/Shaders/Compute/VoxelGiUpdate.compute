#pragma kernel CSComputeRadiance
#pragma kernel CSComputeIrradiancePathTracing
#pragma kernel CSComputeIrradianceLPV
#pragma kernel CSBlurIrradiance
#pragma kernel CSClearVolume
#pragma kernel CSComputeAverageLuminance

// --- CONSTANTS ---
// LPV neighbor propagation factor
#define LPV_PROPAGATION_STRENGTH 0.97
// Keep in sync with LightingManager.MaxPointLights and MaxSpotLights.
#define MAX_POINT_LIGHTS 4
#define MAX_SPOT_LIGHTS 4
#define MAX_SDF_DIST 1.0e+10

#include "../Includes/Volume.hlsl"

// --- RESOURCES ---

// Inputs (Read Only)
Texture3D<float4> _MaterialAlbedoIntensity; // RGB = Albedo, A = Emission Intensity

// GI field buffers
Texture3D<float4> _RadianceField;          // Current Frame Radiance (read in irradiance pass)
RWTexture3D<float4> _RadianceFieldWrite;   // Current Frame Radiance (write in radiance pass)
Texture3D<float4> _IrradianceFieldHistory; // Previous Frame Irradiance (read in both passes)
RWTexture3D<float4> _IrradianceFieldWrite; // Current Frame Irradiance (write in irradiance pass)
Texture3D<float4> _IrradianceFieldInput;   // Temporal irradiance (read in blur pass)
RWTexture3D<float4> _IrradianceFieldFinal; // Final blurred irradiance
RWTexture3D<float4> _ClearVolumeTarget;

// Auto-exposure luminance reduction buffer (sum, count)
RWStructuredBuffer<uint> _LuminanceResult;

// Blue noise for stochastic sampling
Texture2D<float> _BlueNoiseTex;

// --- UNIFORMS ---
float3 _RadianceTextureSize;
uint _FrameCount;
uint _RaysPerFrame;
float _TemporalBlendWeight;
float3 _DirectLightDir;
float4 _DirectLightColor;
uint _PointLightCount;
float4 _PointLightPositionRange[MAX_POINT_LIGHTS];
float4 _PointLightColor[MAX_POINT_LIGHTS];
uint _SpotLightCount;
float4 _SpotLightPositionRange[MAX_SPOT_LIGHTS];
float4 _SpotLightDirectionAngleScale[MAX_SPOT_LIGHTS];
float4 _SpotLightColorAngleOffset[MAX_SPOT_LIGHTS];
float3 _SkyColor;
int _InjectLpvSky;
float _LpvDecay;
float3 _CameraPosition;
float3 _CameraForward;
float _LuminanceRadius;

bool HasOpenSky(uint3 id)
{
    [loop]
    for (uint y = id.y + 1; y < (uint)_RadianceTextureSize.y; y++) {
        if (_DistanceField.Load(int4((int)id.x, (int)y, (int)id.z, 0)).r < 0.0) {
            return false;
        }
    }

    return true;
}

float GetLocalLightRangeAttenuation(float distSq, float rangeSq)
{
    // Inverse-square distance falloff (physical light intensity) combined with
    // a smooth range window that fades to zero at max range.
    float distanceAtten = rcp(max(distSq, 0.01));
    float rangeFade = saturate(1.0 - (distSq / max(rangeSq, 1e-6)));
    return distanceAtten * rangeFade * rangeFade;
}

float3 GetIndirectSkyLight(float3 rayDir, bool includeSun)
{
    float3 environmentLight = _SkyColor;
    if (!includeSun) {
        return environmentLight;
    }

    // Use a deliberately broad sun lobe here. A physical sun disk is too small
    // to be sampled reliably at 1-4 rays per frame, which leaves rooms lit
    // through small openings much darker than the user expects.
    float sunLobe = saturate(dot(rayDir, _DirectLightDir));
    sunLobe *= sunLobe;
    return environmentLight + (_DirectLightColor.rgb * sunLobe);
}

float3 GetPointLight(float3 voxelCenter, float startOffset)
{
    float3 totalLight = 0.0;
    uint pointLightCount = min(_PointLightCount, (uint)MAX_POINT_LIGHTS);

    [loop]
    for (uint lightIndex = 0u; lightIndex < pointLightCount; lightIndex++) {
        float4 positionRange = _PointLightPositionRange[lightIndex];
        float3 toLight = positionRange.xyz - voxelCenter;
        float distSq = dot(toLight, toLight);
        float rangeSq = positionRange.w * positionRange.w;
        if (distSq <= 1e-6 || distSq >= rangeSq) {
            continue;
        }

        float invDistance = rsqrt(distSq);
        float distanceToLight = distSq * invDistance;
        float3 lightDir = toLight * invDistance;
        float3 hitPos;
        float visibility = RaymarchSDF(voxelCenter, lightDir, startOffset, distanceToLight, hitPos);
        float attenuation = visibility * GetLocalLightRangeAttenuation(distSq, rangeSq);
        totalLight += _PointLightColor[lightIndex].rgb * attenuation;
    }

    return totalLight;
}

float3 GetSpotLight(float3 voxelCenter, float startOffset)
{
    float3 totalLight = 0.0;
    uint spotLightCount = min(_SpotLightCount, (uint)MAX_SPOT_LIGHTS);

    [loop]
    for (uint lightIndex = 0u; lightIndex < spotLightCount; lightIndex++) {
        float4 positionRange = _SpotLightPositionRange[lightIndex];
        float3 toLight = positionRange.xyz - voxelCenter;
        float distSq = dot(toLight, toLight);
        float rangeSq = positionRange.w * positionRange.w;
        if (distSq <= 1e-6 || distSq >= rangeSq) {
            continue;
        }

        float invDistance = rsqrt(distSq);
        float distanceToLight = distSq * invDistance;
        float3 lightDir = toLight * invDistance;

        float4 directionAngleScale = _SpotLightDirectionAngleScale[lightIndex];
        float4 colorAngleOffset = _SpotLightColorAngleOffset[lightIndex];
        float coneAttenuation = saturate(dot(-lightDir, directionAngleScale.xyz) * directionAngleScale.w + colorAngleOffset.a);
        if (coneAttenuation <= 0.0) {
            continue;
        }

        float3 hitPos;
        float visibility = RaymarchSDF(voxelCenter, lightDir, startOffset, distanceToLight, hitPos);
        float attenuation = visibility * GetLocalLightRangeAttenuation(distSq, rangeSq) * (coneAttenuation * coneAttenuation);
        totalLight += colorAngleOffset.rgb * attenuation;
    }

    return totalLight;
}

[numthreads(8, 8, 8)]
void CSClearVolume(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= uint3(_RadianceTextureSize.xyz))) return;
    _ClearVolumeTarget[id] = 0;
}

// ----------------------------------------------------------
// RADIANCE PASS
// Calculate how much light this voxel emits.
// Only near-surface voxels emit light, to limit light bleeding and keep the GI field more stable.
// ----------------------------------------------------------
[numthreads(8, 8, 8)]
void CSComputeRadiance(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= uint3(_RadianceTextureSize.xyz))) return;

    float3 voxelCenter = _VolumePosition + (float3(id) * _VoxelSize) + (_VoxelSize * 0.5);
    float3 uvw = WorldToVoxelUV(voxelCenter);
    float dist = _DistanceField.SampleLevel(pointClampSampler, uvw, 0).r;
    bool isAir = dist >= 0;
    bool shouldInjectSky = _InjectLpvSky != 0 && isAir && HasOpenSky(id);
    float3 outgoingLight = shouldInjectSky ? _SkyColor : 0.0;

    // Only near-surface voxels radiate. dist >= 0 includes voxels exactly on the
    // surface (e.g. wall mesh perfectly aligned to the voxel grid). LightingVolume
    // expands bounds so the GI/SDF grid stays cubic, so _VoxelSize.x is the single
    // world-space edge length for this grid.
    bool shouldRadiate = dist >= 0 && dist <= _VoxelSize.x;
    if (!shouldRadiate) {
        _RadianceFieldWrite[id] = float4(outgoingLight, 1.0);
        return;
    }

    // Get indirect light from GI field.
    float3 surfaceIrradiance = _IrradianceFieldHistory.SampleLevel(pointClampSampler, uvw, 0).rgb;
    // -- Self-occlusion bias (start offset for shadow rays) --
    //
    // RayMarchTex3D treats any sample with d <= EPSILON as a hit. A near-surface
    // voxel whose own center sits inside that EPSILON shell would therefore
    // self-occlude every shadow ray on the very first step, regardless of which
    // direction the ray points, leaving the voxel permanently black.
    //
    // We skip past the shell by giving the raymarcher a startOffset large
    // enough to clear EPSILON plus one minimum raymarch step. Using only
    // EPSILON is not enough because the hit test is d <= EPSILON, so a sample
    // that lands exactly on the threshold still self-hits.
    //
    // If EPSILON or RAYMARCH_MIN_STEP changes in Volume.hlsl, this helper
    // stays in sync automatically.
    float startOffset = ComputeRaymarchStartOffset(dist);
    // Get direct sun light
    // TODO: Optimize by sampling a shadowmap as a crude first step, then only raymarch if needed?
    float3 hitPos;
    float sunVisibility = RaymarchSDF(voxelCenter, _DirectLightDir, startOffset, MAX_SDF_DIST, hitPos);
    float3 sunLight = _DirectLightColor.rgb * sunVisibility;
    float3 pointLight = GetPointLight(voxelCenter, startOffset);
    float3 spotLight = GetSpotLight(voxelCenter, startOffset);
    // Get surface albedo and emissive intensity (alpha is 8-bit log-encoded intensity)
    float4 albedoIntensity = _MaterialAlbedoIntensity.SampleLevel(pointClampSampler, uvw, 0);
    float emissionIntensity = DecodeEmissionIntensityFrom8Bit(albedoIntensity.a);
    float3 emissiveLight = albedoIntensity.rgb * emissionIntensity;

    // Radiate reflected incoming light plus emissive contribution.
    // float3 safeAlbedo = min(albedoIntensity.rgb, float3(0.9f, 0.9f, 0.9f));
    float3 safeAlbedo = albedoIntensity.rgb;
    float3 directLight = sunLight + pointLight + spotLight;
    outgoingLight += ((surfaceIrradiance + directLight) * safeAlbedo.rgb) + emissiveLight;
    _RadianceFieldWrite[id] = float4(outgoingLight, 1.0);
}

// ----------------------------------------------------------
// IRRADIANCE PASS
// How much light is arriving at this voxel.
// ----------------------------------------------------------
[numthreads(8, 8, 8)]
void CSComputeIrradiancePathTracing(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= uint3(_RadianceTextureSize.xyz))) return;

    float3 voxelCenter = _VolumePosition + (float3(id) * _VoxelSize) + (_VoxelSize * 0.5);
    float3 uvw = WorldToVoxelUV(voxelCenter);
    // Abort if inside geometry.
    half dist = _DistanceField.SampleLevel(pointClampSampler, uvw, 0).r;
    if (dist < 0) {
        _IrradianceFieldWrite[id] = 0;
        return;
    }
    bool isAir = (dist > _VoxelSize.x);

    float3 incomingLight = float3(0, 0, 0);
    float3 surfaceNormal = GetNormalFromSDF(voxelCenter);
    // Same self-occlusion bias as the radiance pass: lift the ray start past
    // the EPSILON shell around the originating voxel so near-surface voxels
    // don't immediately self-hit on every gathered direction. See the longer
    // explanation in CSComputeRadiance and Volume.hlsl.
    float startOffset = ComputeRaymarchStartOffset(dist);
    uint rayCount = max(_RaysPerFrame, 1u);

    [loop] // TODO: Change to [unroll] and rayCount to compile time constant (1=Mobile, 4=PC)
    for (uint rayIndex = 0u; rayIndex < rayCount; rayIndex++) {
        float2 noise2 = GetBlueNoise2(_BlueNoiseTex, id, _FrameCount, rayIndex);
        half3 rayDir;
        if (!isAir) {
            rayDir = CosineSampleHemisphere(surfaceNormal, noise2);
        } else {
            rayDir = GetRandomDirectionFromNoise2(noise2);
        }

        float3 hitPos;
        float lit = RaymarchSDF(voxelCenter, rayDir, startOffset, MAX_SDF_DIST, hitPos);
        if (lit == 0) {
            // Sample value half a voxel away from the surface hit point, to avoid sampling a voxel center inside the surface.
            float3 surfaceUVW = WorldToVoxelUV(hitPos - rayDir * _VoxelSize * 0.51);
            incomingLight += _RadianceField.SampleLevel(linearClampSampler, surfaceUVW, 0).rgb;
        } else {
            // No hit means the ray escaped to the environment.
            // Only air voxels add the sun miss term; near-surface shell voxels
            // already get explicit direct sun in the radiance pass.
            incomingLight += GetIndirectSkyLight(rayDir, isAir) * lit;
        }
    }

    incomingLight *= rcp((float)rayCount);

    float4 history = _IrradianceFieldHistory.Load(int4(id, 0));
    float3 oldColor = history.rgb;
    float3 finalColor = lerp(oldColor, incomingLight, saturate(_TemporalBlendWeight));

    _IrradianceFieldWrite[id] = float4(finalColor, 1.0);
}

// Light Propagation Volumes (LPV) in this implementation:
// 1) Gather irradiance from the 6 axis-aligned neighbors.
// 2) Reject propagation through potential walls using an SDF midpoint test.
// 3) Inject fresh radiance from this voxel (emissive + reflected/direct from radiance pass).
// 4) Apply damping controls to prevent runaway brightening over many frames.
[numthreads(8, 8, 8)]
void CSComputeIrradianceLPV(uint3 id : SV_DispatchThreadID)
{
    // Early exit if out of bounds (can happen with non-dispatch-aligned volume sizes)
    if (any(id >= uint3(_RadianceTextureSize.xyz))) return;

    float3 voxelCenter = _VolumePosition + (float3(id) * _VoxelSize) + (_VoxelSize * 0.5);
    half dist = _DistanceField.Load(int4(id, 0)).r;
    if (dist < 0) {
        _IrradianceFieldWrite[id] = 0;
        return;
    }

    // Gather light from air neighbors. Skip neighbors inside geometry.
    float3 sum = 0.0;
    const int3 neighborOffsets[6] = {
        int3(1, 0, 0),
        int3(-1, 0, 0),
        int3(0, 1, 0),
        int3(0, -1, 0),
        int3(0, 0, 1),
        int3(0, 0, -1)
    };
    float3 maxNeighbor = 0.0; // Track the brightest neighbor!
    [unroll]
    for (int i = 0; i < 6; i++) {
        int3 delta = neighborOffsets[i];
        int3 n = id + delta;
        if (any(n < 0) || any(n >= _RadianceTextureSize)) continue;

        // Prevent light bleed through walls by checking the SDF at the midpoint between the two voxels.
        // If distance is < 0, weight is 0.0 (fully blocked).
        // If distance is > a full voxel away, weight is 1.0 (fully open).
        // If it's in between, fade. This removes squared blocky AO.
        float3 midPos = voxelCenter + float3(delta) * (_VoxelSize * 0.5f);
        float midDist = SampleSDF(midPos);
        float transferWeight = saturate(midDist / _VoxelSize.x);
        if (transferWeight <= 0.0f) continue;

        float3 neighborLight = _IrradianceFieldHistory.Load(int4(n, 0)).rgb;
        sum += neighborLight * transferWeight;
        maxNeighbor = max(maxNeighbor, neighborLight * transferWeight);
    }

    // Add lights from neighbors together, but clamp to brightest neighbor.
    float3 propagated = min(sum, maxNeighbor);
    // Controls "how fast" light travels through the grid per iteration.
    // 1.0 = full neighbor average, lower values = slower spread.
    propagated *= LPV_PROPAGATION_STRENGTH;

    // Decay controls retention of propagated light.
    // Inverted decay (1 - decay) is used as radiance injection weight.
    //
    // LPV is sampled on the air side of surfaces, but direct/bounce radiance is
    // concentrated in the near-surface shell. Loading only _RadianceField[id]
    // makes an air receiver voxel miss nearby lit shell voxels unless the light
    // happens to land on exactly the same cell. That showed up as roofs lighting
    // while floors / side walls stayed dark.
    //
    // Pull the injection sample back toward the nearest surface until the sample
    // sits about half a voxel outside it. This keeps the lookup on the air side
    // while allowing LPV receiver voxels to see the directly lit shell.
    float3 surfaceNormal = GetNormalFromSDF(voxelCenter);
    float radianceBackoff = max(dist - (_VoxelSize.x * 0.5f), 0.0f);
    float3 radianceSamplePos = voxelCenter - surfaceNormal * radianceBackoff;
    float3 radianceUVW = WorldToVoxelUV(radianceSamplePos);
    float3 injectedRadiance = _RadianceField.SampleLevel(linearClampSampler, radianceUVW, 0).rgb * (1.0 - _LpvDecay);
    float3 incomingLight = max((propagated * _LpvDecay) + injectedRadiance, 0.0);
    _IrradianceFieldWrite[id] = float4(incomingLight, 1.0);
}

// ----------------------------------------------------------
// SPATIAL BLUR PASS
// Turbo 8-tap blur: sample voxel corners with linear sampling.
// ----------------------------------------------------------
[numthreads(8, 8, 8)]
void CSBlurIrradiance(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= uint3(_RadianceTextureSize.xyz))) return;

    float3 voxelCenter = _VolumePosition + (float3(id) * _VoxelSize) + (_VoxelSize * 0.5);
    float3 uvwCenter = WorldToVoxelUV(voxelCenter);
    float3 uvwHalf = (_VoxelSize * 0.5) * rcp(max(_VolumeSize, 1e-6));

    // _IrradianceFieldFinal[id] = _IrradianceFieldInput.SampleLevel(linearClampSampler, uvwCenter, 0);
    // return;

    float3 sum = 0.0;
    sum += _IrradianceFieldInput.SampleLevel(linearClampSampler, uvwCenter + float3(-uvwHalf.x, -uvwHalf.y, -uvwHalf.z), 0).rgb;
    sum += _IrradianceFieldInput.SampleLevel(linearClampSampler, uvwCenter + float3( uvwHalf.x, -uvwHalf.y, -uvwHalf.z), 0).rgb;
    sum += _IrradianceFieldInput.SampleLevel(linearClampSampler, uvwCenter + float3(-uvwHalf.x,  uvwHalf.y, -uvwHalf.z), 0).rgb;
    sum += _IrradianceFieldInput.SampleLevel(linearClampSampler, uvwCenter + float3( uvwHalf.x,  uvwHalf.y, -uvwHalf.z), 0).rgb;
    sum += _IrradianceFieldInput.SampleLevel(linearClampSampler, uvwCenter + float3(-uvwHalf.x, -uvwHalf.y,  uvwHalf.z), 0).rgb;
    sum += _IrradianceFieldInput.SampleLevel(linearClampSampler, uvwCenter + float3( uvwHalf.x, -uvwHalf.y,  uvwHalf.z), 0).rgb;
    sum += _IrradianceFieldInput.SampleLevel(linearClampSampler, uvwCenter + float3(-uvwHalf.x,  uvwHalf.y,  uvwHalf.z), 0).rgb;
    sum += _IrradianceFieldInput.SampleLevel(linearClampSampler, uvwCenter + float3( uvwHalf.x,  uvwHalf.y,  uvwHalf.z), 0).rgb;

    _IrradianceFieldFinal[id] = float4(sum * 0.125f, 1.0);
}

// ----------------------------------------------------------
// AUTO-EXPOSURE: Compute average log-luminance in the camera's
// view direction. Only samples voxels within _LuminanceRadius
// that lie in a forward-facing cone (dot >= 0 with camera forward)
// and outside geometry (dist >= 0).
// ----------------------------------------------------------
[numthreads(8, 8, 8)]
void CSComputeAverageLuminance(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= uint3(_RadianceTextureSize.xyz))) return;

    float3 voxelCenter = _VolumePosition + (float3(id) * _VoxelSize) + (_VoxelSize * 0.5);

    float3 offset = voxelCenter - _CameraPosition;
    float distSq = dot(offset, offset);
    // Skip voxels outside the sampling radius.
    if (distSq > _LuminanceRadius * _LuminanceRadius) return;
    // Skip voxels behind the camera. Weight by how aligned the voxel
    // direction is with the camera forward (cosine weighting).
    float invDist = rsqrt(max(distSq, 1e-6));
    float cosAngle = dot(offset * invDist, _CameraForward);
    if (cosAngle < 0.0) return;

    float3 uvw = WorldToVoxelUV(voxelCenter);
    half dist = _DistanceField.SampleLevel(pointClampSampler, uvw, 0).r;
    // Skip voxels inside geometry.
    if (dist < 0) return;

    float3 irr = _IrradianceFieldInput.Load(int4(id, 0)).rgb;
    float lum = dot(irr, float3(0.2126, 0.7152, 0.0722));
    // Cosine-weight: voxels more centered in view contribute more.
    // Scale luminance by cosAngle so off-axis voxels have less influence.
    float weightedLum = lum * cosAngle;
    float logLum = log2(max(weightedLum, 1e-4));
    uint encoded = (uint)((logLum + 16.0) * 1024.0);
    InterlockedAdd(_LuminanceResult[0], encoded);
    InterlockedAdd(_LuminanceResult[1], 1u);
}
