.screen {
    flex-grow: 1;
    padding-top: 18px;
    padding-left: 18px;
    align-items: flex-start;
    justify-content: flex-start;
}

.panel {
    width: 360px;
    padding-top: 18px;
    padding-right: 18px;
    padding-bottom: 18px;
    padding-left: 18px;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.12);
    border-right-color: rgba(255, 255, 255, 0.12);
    border-top-color: rgba(255, 255, 255, 0.12);
    border-bottom-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(10, 16, 24, 0.9);
}

.panel-title {
    color: rgb(244, 241, 226);
    font-size: 19px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.panel-accent {
    height: 3px;
    width: 100%;
    margin-bottom: 12px;
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-right-radius: 999px;
    border-bottom-left-radius: 999px;
    background-color: rgb(227, 172, 61);
}

.section-title {
    margin-top: 10px;
    margin-bottom: 6px;
    color: rgba(255, 255, 255, 0.68);
    font-size: 11px;
    -unity-font-style: bold;
}

.section-body {
    margin-bottom: 4px;
}

.debug-info-section {
    width: 100%;
}

.debug-info-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.debug-info-header-row {
    margin-bottom: 2px;
}

.debug-info-caption {
    width: 68px;
    min-width: 68px;
    margin-right: 6px;
    color: rgba(255, 255, 255, 0.78);
    font-size: 11px;
}

.debug-info-heading {
    width: 72px;
    min-width: 72px;
    max-width: 72px;
    margin-right: 6px;
    color: rgba(255, 255, 255, 0.58);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.debug-info-cell {
    width: 72px;
    min-width: 72px;
    max-width: 72px;
    margin-right: 6px;
    color: rgb(244, 241, 226);
    font-size: 11px;
    -unity-text-align: middle-right;
    white-space: nowrap;
}

.debug-info-cell-wide {
    flex-grow: 1;
    width: auto;
    min-width: 0;
    max-width: none;
    margin-right: 0;
}

.setting-field {
    margin-bottom: 8px;
}

.setting-field .unity-base-field__label {
    min-width: 148px;
    color: rgba(255, 255, 255, 0.82);
}

.setting-field .unity-base-field__input {
    min-height: 30px;
    padding-top: 6px;
    padding-right: 8px;
    padding-bottom: 6px;
    padding-left: 8px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(227, 172, 61, 0.3);
    border-right-color: rgba(227, 172, 61, 0.3);
    border-top-color: rgba(227, 172, 61, 0.3);
    border-bottom-color: rgba(227, 172, 61, 0.3);
    background-color: rgba(255, 255, 255, 0.06);
    color: rgb(244, 241, 226);
}

.setting-field.debug-focused-input .unity-base-field__label {
    color: rgb(255, 183, 77);
}

.setting-field.debug-focused-input .unity-base-field__input {
    border-left-color: rgb(255, 99, 71);
    border-right-color: rgb(255, 99, 71);
    border-top-color: rgb(255, 99, 71);
    border-bottom-color: rgb(255, 99, 71);
    background-color: rgba(255, 99, 71, 0.18);
}

.debug-focused-text-input {
    background-color: rgba(255, 232, 140, 0.22);
    color: rgb(255, 247, 214);
}

.setting-field.unity-toggle {
    min-height: 28px;
}

.setting-field.unity-toggle .unity-base-field__input {
    min-width: 18px;
    min-height: 18px;
}

.hint-card {
    margin-top: 10px;
    padding-top: 10px;
    padding-right: 12px;
    padding-bottom: 10px;
    padding-left: 12px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
    background-color: rgba(227, 172, 61, 0.08);
}

.hint-text {
    color: rgba(255, 248, 220, 0.85);
    font-size: 11px;
    margin-bottom: 2px;
}
