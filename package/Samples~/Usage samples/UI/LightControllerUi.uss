.screen {
    flex-grow: 1;
    padding-top: 18px;
    padding-left: 18px;
    align-items: flex-start;
    justify-content: flex-start;
}

.panel {
    width: 360px;
    padding: 18px;
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(10, 16, 24, 0.9);
}

.panel-title {
    color: rgb(244, 241, 226);
    font-size: 19px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.panel-accent {
    height: 3px;
    width: 100%;
    margin-bottom: 12px;
    border-radius: 999px;
    background-color: rgb(227, 172, 61);
}

.section-title {
    margin-top: 10px;
    margin-bottom: 6px;
    color: rgba(255, 255, 255, 0.68);
    font-size: 11px;
    -unity-font-style: bold;
}

.section-body {
    margin-bottom: 4px;
}

.debug-info-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.debug-info-header-row {
    margin-bottom: 2px;
}

.debug-info-caption {
    flex-shrink: 0;
    margin-right: 6px;
    color: rgba(255, 255, 255, 0.78);
    font-size: 11px;
}

.debug-info-heading {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 60px;
    margin-right: 6px;
    color: rgba(255, 255, 255, 0.58);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.debug-info-cell {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 60px;
    margin-right: 6px;
    color: rgb(244, 241, 226);
    font-size: 11px;
    -unity-text-align: middle-right;
    white-space: nowrap;
}

.setting-field {
    margin-bottom: 8px;
}

.setting-field .unity-base-field__label {
    color: rgba(255, 255, 255, 0.82);
}

.setting-field .unity-base-field__input {
    flex-grow: 1;
    padding: 6px 8px;
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(227, 172, 61, 0.3);
    background-color: rgba(255, 255, 255, 0.06);
    color: rgb(244, 241, 226);
}

.setting-field .unity-enum-field__text {
    margin-right: 4px;
}

.setting-field.debug-focused-input .unity-base-field__label {
    color: rgb(255, 183, 77);
}

.setting-field.debug-focused-input .unity-base-field__input {
    border-color: rgb(255, 99, 71);
    background-color: rgba(255, 99, 71, 0.18);
}

.debug-focused-text-input {
    background-color: rgba(255, 232, 140, 0.22);
    color: rgb(255, 247, 214);
}

.hint-card {
    margin-top: 10px;
    padding: 10px 12px;
    border-radius: 12px;
    background-color: rgba(227, 172, 61, 0.08);
}

.hint-text {
    color: rgba(255, 248, 220, 0.85);
    font-size: 11px;
    margin-bottom: 2px;
}

.unity-base-dropdown__item {
    padding: 1px 1px;
}
