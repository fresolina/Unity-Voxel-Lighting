<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Samples/Usage%20samples/UI/LightControllerUi.uss?fileID=7433441132597879392&amp;guid=8d4ea996832866749b010f7cdbe934ac&amp;type=3#LightControllerUi"/>
    <ui:VisualElement name="screen" class="screen">
        <ui:VisualElement name="panel" class="panel">
            <ui:VisualElement name="panel-header" class="panel-header">
                <ui:Label name="fold-arrow" text="▾" class="fold-arrow"/>
                <ui:Label name="panel-title" text="Lighting Controls" class="panel-title"/>
            </ui:VisualElement>
            <ui:VisualElement name="panel-body">
            <ui:VisualElement class="panel-accent"/>
            <ui:VisualElement name="settings-container" class="section-body">
                <ui:EnumField label="GI" value="BufferGi" type="Lotec.Lighting.GiMethod, Lotec.Lighting" name="gi-enum" tooltip="Which GI system runs (toggles the GI updater components)." class="setting-field">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="Gi" binding-mode="TwoWay"/>
                    </Bindings>
                </ui:EnumField>
                <ui:EnumField label="Voxel GI Method [§]" value="LPV" type="Lotec.Lighting.GiFieldUpdater+LightingMethod, Lotec.Lighting" name="lighting-method-enum" tooltip="Solve method of the texture Voxel GI (only when GI = VoxelGi)." class="setting-field">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="LightingMethod" binding-mode="TwoWay"/>
                    </Bindings>
                </ui:EnumField>
                <ui:IntegerField name="samples-per-frame-field" label="GI Samples/Frame" is-delayed="true" tooltip="Buffer GI samples (rays) gathered per voxel per frame. Higher converges faster but costs more (1 for Quest)." tabindex="-1" class="setting-field">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="SamplesPerFrame" binding-mode="TwoWay"/>
                    </Bindings>
                </ui:IntegerField>
                <ui:Slider name="confidence-curve-slider" label="Confidence Curve" low-value="1" high-value="8" show-input-field="true" tooltip="Ease-in exponent for the displayed reveal/fade (1 = linear). Higher keeps noisy early accumulation frames hidden." class="setting-field">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="ConfidenceCurve" binding-mode="TwoWay"/>
                    </Bindings>
                </ui:Slider>
                <ui:Slider name="ao-strength-slider" label="AO Strength" low-value="0" high-value="1" show-input-field="true" tooltip="Strength of the baked static ambient occlusion (0 = off). Darkens GI in concave corners and near-contact gaps." class="setting-field">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="AoStrength" binding-mode="TwoWay"/>
                    </Bindings>
                </ui:Slider>
                <ui:EnumField label="Shadow Mode" value="Baked" type="Lotec.Lighting.Samples.LightControllerUi+ShadowUiMode, Assembly-CSharp" name="shadow-mode-enum" tooltip="Baked: BufferGI fine-field voxel sun-shadow (pre-marched, soft, cheap). Others: the volume shadow source used by the SDF/texture shadow path." class="setting-field">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="ShadowMode" binding-mode="TwoWay"/>
                    </Bindings>
                </ui:EnumField>
                <ui:Toggle name="tonemap-toggle" label="Tonemap In Shader" tooltip="Apply the display transform (exposure + tonemap) in the lit shader. Off = output linear HDR for a post-processing stack (also skips auto-exposure)." class="setting-field">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="TonemapInShader" binding-mode="TwoWay"/>
                    </Bindings>
                </ui:Toggle>
                <ui:FloatField name="enabled-light-intensity-field" label="Light Intensity [1-9]" is-delayed="true" tooltip="Type a value and press Enter or click away. Applies to the enabled flashlight and candle." tabindex="-1" class="setting-field">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="EnabledLightIntensity" binding-mode="TwoWay"/>
                    </Bindings>
                </ui:FloatField>
                <ui:Toggle name="flashlight-toggle" label="Flashlight [F]" class="setting-field">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="FlashlightEnabled" binding-mode="TwoWay"/>
                    </Bindings>
                </ui:Toggle>
                <ui:Toggle name="candle-toggle" label="Candle [G]" class="setting-field">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="CandleEnabled" binding-mode="TwoWay"/>
                    </Bindings>
                </ui:Toggle>
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; align-items: flex-start;">
                <ui:VisualElement class="section-body debug-info-section">
                    <ui:VisualElement class="debug-info-row">
                        <ui:Label text="FPS" class="debug-info-caption"/>
                        <ui:Label name="fps-value" class="fps-value"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="debug-info-row debug-info-header-row">
                        <ui:Label text="Frame Time" class="debug-info-caption"/>
                        <ui:Label text="Low" class="debug-info-heading"/>
                        <ui:Label text="High" class="debug-info-heading"/>
                        <ui:Label text="Avg" class="debug-info-heading"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="debug-info-row">
                        <ui:Label text="1s" class="debug-info-caption"/>
                        <ui:Label name="frame-time-last-second-low-value" class="debug-info-cell"/>
                        <ui:Label name="frame-time-last-second-high-value" class="debug-info-cell"/>
                        <ui:Label name="frame-time-last-second-average-value" class="debug-info-cell"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="hint-card">
                <ui:Label text="CTRL + mouse: rotate the sun light." class="hint-text"/>
                <ui:Label text="H: toggle UI." class="hint-text"/>
            </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
