// Buffer-GI compute: the textureless, cache-resident voxel GI solve.
//   CSClear     - zero the dynamic fields.
//   CSInject    - per solid voxel: outgoing radiance = emissive + albedo*(direct + bounce), where
//                 bounce is the surface's own front-hemisphere incident irradiance (from CSGather).
//   CSGather    - per voxel, 1+ rays/frame + in-place temporal EMA: AIR = omnidirectional irradiance
//                 probe (sampled by the fragment read); SOLID = front-hemisphere incident irradiance
//                 (feeds CSInject's bounce, so a surface no longer reads its own radiance back).
//   CSBlur      - occupancy-gated spatial blur into _IrradianceBlur (hides the 1-ray/frame shimmer
//                 the temporal EMA leaves behind); the fragment read samples the blurred buffer.
// Albedo/emission (_Material) and every other STATIC field are produced by BufferGiBake.compute at
// bake time; this file only reads them (see BufferGiVoxelData.hlsl). All solidity tests (visibility
// DDA, gates) read the 1-bit occupancy bitfield; _Material is inject-only. No SDF, no textures.
#pragma kernel CSClear
#pragma kernel CSInject
#pragma kernel CSGather
#pragma kernel CSBlur
#pragma kernel CSInitFineFromCoarse
#pragma kernel CSAverageLuminance

#define MAX_POINT_LIGHTS 4
#define MAX_SPOT_LIGHTS 4

#include "../../ShaderLibrary/BufferGiField.hlsl"
#include "../../ShaderLibrary/Math.hlsl"
#include "../../ShaderLibrary/BufferGiVoxelData.hlsl"

// --- Fields ---
// Radiance is the one field with a per-voxel STRIDE: _BgiRadianceDirs slots per voxel, contiguous.
// Never index it directly - go through BgiRadianceSlot / BgiRadianceBase (BufferGiField.hlsl), which
// are the only places that know the direction mode.
RWStructuredBuffer<uint2> _Radiance;    // outgoing radiance (fp16x3) per face, stored in solid voxels
RWStructuredBuffer<uint2> _Irradiance;  // accumulated incoming light (rgb) + sample count (w)
RWStructuredBuffer<uint2> _IrradianceBlur; // spatially blurred irradiance; the confidence ease's history
// The current field's blurred irradiance, written by CSBlur (alongside _IrradianceBlur) - this is what
// the fragment actually reads, with a single hardware-trilinear tap. C# binds this to the
// field's Texture3D per blur dispatch (fine / coarse); write-only UAV store (no typed-load needed).
// RGB only: the alpha carried the baked sun visibility until that moved to its own texture below, and
// is now written as a constant 0. Nothing reads it (see BgiSampleShadowTexture).
RWTexture3D<float4> _BgiIrradianceTexWrite;
// Sun visibility written into the mirror's alpha when nothing reads it there. A named constant so the
// dead channel is obviously dead rather than looking like a value someone chose.
#define BGI_MIRROR_ALPHA_UNUSED 0.0
// Zero every direction slot of one voxel. Air voxels and clears must wipe the whole run, not just
// slot 0, or a stale back/side face survives a mode switch or a field reset.
void BgiClearRadiance(uint voxelSlot) {
    uint base_ = BgiRadianceBase(voxelSlot);
    uint dirs = BgiRadianceDirs();
    [loop]
    for (uint s = 0u; s < dirs; s++) _Radiance[base_ + s] = uint2(0u, 0u);
}

// Zero every irradiance bucket of one voxel (1 outside Cube, 6 in it).
void BgiClearIrradiance(uint voxelSlot) {
    uint base_ = BgiIrradianceBase(voxelSlot);
    uint dirs = BgiIrradianceDirs();
    [loop]
    for (uint b = 0u; b < dirs; b++) {
        _Irradiance[base_ + b] = uint2(0u, 0u);
        _IrradianceBlur[base_ + b] = uint2(0u, 0u);
    }
}

// Incident irradiance at a voxel for a surface facing `n`, reconstructed from the cube buckets by
// the standard n^2 ambient-cube weights (3 of 6 buckets, weights summing to 1). Outside Cube it is
// just the single direction-less value, so callers need no mode branch of their own.
half3 BgiGatheredIrradiance(uint voxelSlot, float3 n, out half sunOut) {
    uint dirs = BgiIrradianceDirs();
    if (dirs == 1u) {
        half3 c; half w; BgiUnpackRgbH(_Irradiance[voxelSlot], c, w);
        sunOut = w; return c;
    }
    uint base_ = voxelSlot * dirs;
    float3 n2 = n * n;
    float3 acc = 0; half sun = 1.0h;
    [unroll]
    for (uint a = 0u; a < 3u; a++) {
        float d  = (a == 0u) ? n.x  : ((a == 1u) ? n.y  : n.z);
        float w2 = (a == 0u) ? n2.x : ((a == 1u) ? n2.y : n2.z);
        half3 c; half sw; BgiUnpackRgbH(_Irradiance[base_ + a * 2u + (d >= 0.0 ? 1u : 0u)], c, sw);
        acc += (float3)c * w2;
        sun = sw; // identical across buckets (CSGather writes the same visibility into each)
    }
    sunOut = sun;
    return (half3)acc;
}

// Direction-less average over the buckets, for the consumers that have no surface normal: the air
// probe's displayed value and the auto-exposure measurement. Equal weights, so it is the mean
// radiance over the sphere - what the single-slot field always held.
half3 BgiOmniIrradiance(uint voxelSlot, out half sunOut) {
    uint dirs = BgiIrradianceDirs();
    if (dirs == 1u) {
        half3 c; half w; BgiUnpackRgbH(_Irradiance[voxelSlot], c, w);
        sunOut = w; return c;
    }
    uint base_ = voxelSlot * dirs;
    float3 acc = 0; half sun = 1.0h;
    [unroll]
    for (uint b = 0u; b < 6u; b++) {
        half3 c; half sw; BgiUnpackRgbH(_Irradiance[base_ + b], c, sw);
        acc += (float3)c; sun = sw;
    }
    sunOut = sun;
    return (half3)(acc * (1.0 / 6.0));
}

RWStructuredBuffer<uint>  _LuminanceResult; // [0] = encoded log-luminance sum, [1] = sample count (auto-exposure)
// --- Solve uniforms ---
uint  _FrameCount;
uint  _SamplesPerFrame;
// Rays this voxel had already gathered before THIS dispatch (= _collectedSamples before the frame's
// increment). The gather's sample index is _SampleBase + rayIndex, so the sample sequence depends on
// the ray ordinal alone and never on how the budget was split across frames. See GiSampleNoise.
uint  _SampleBase;
float _Confidence; // 0 at a light change, 1 when converged; CSBlur eases the displayed field by this
float _EmaWeight;  // progressive gather blend weight (samplesPerFrame/totalSamples), from C#
// Coarse grid mapping for CSInitFineFromCoarse (that dispatch's _BgiGrid* uniforms are the FINE grid).
float3 _CoarseGridOrigin;
float3 _CoarseGridVoxelSize;
// Auto-exposure (CSAverageLuminance): sample the displayed field near the camera.
float3 _CameraPosition;
float3 _CameraForward;
float  _LuminanceRadius;
// Non-physical "reach" fill: max multiplier applied to a gather hit at the grid-diagonal distance
// (1 = off/physical). Only the AIR gather uses it, so it brightens the displayed field WITHOUT
// entering the surface bounce feedback (which would diverge if its per-bounce gain exceeded 1).
float _ReachBoost;
float _GiFireflyClamp;
float3 _DirectLightDir;   // toward the light
float4 _DirectLightColor;
// Stratified sun rays in CSInject, for the direct term a SOLID voxel then BOUNCES. Separate from the
// above because it is a different pass at a different resolution: this one runs on the LIGHTING grid,
// where a voxel is metres across and none of the shadow grid's resolution argument applies. Dropping
// it to a single centre ray measured 4.90% brighter overall on Sponza (96% of pixels, max 15/255).
//
// These were ONE setting plus a Centre/Supersampled/Temporal mode until 2026-08-28. The mode selected
// an estimator for the DISPLAYED shadow back when the solve produced it; P6 moved that to
// CSSunVisibility, which finishes each texel in one dispatch and therefore ignored the mode outright.
// So switching modes changed nothing visible - fs reported exactly that - while the tooltip still
// described the Baked shadow. Centre is now just samples = 1, and Temporal's progressive average had
// nothing left to converge for.
int _BgiInjectSunSamples;
// Environment lighting as L2 SH from Unity's ambient probe (which already reflects the Lighting
// window's Environment Source = Skybox / Gradient / Color). Evaluated per escaped-ray direction.
// Packed like Unity's unity_SH* / ShadeSH9.
float4 _EnvShAr; float4 _EnvShAg; float4 _EnvShAb; // L0 + L1
float4 _EnvShBr; float4 _EnvShBg; float4 _EnvShBb; // L2 (xy, yz, zz*3, zx)
float4 _EnvShC;                                    // L2 (x^2 - y^2), per channel
float3 _AmbientFloor; // constant indirect fill so shadowed/enclosed air is never pure black
uint   _PointLightCount;
float4 _PointLightPositionRange[MAX_POINT_LIGHTS];
float4 _PointLightColor[MAX_POINT_LIGHTS];
uint   _SpotLightCount;
float4 _SpotLightPositionRange[MAX_SPOT_LIGHTS];
float4 _SpotLightDirectionAngleScale[MAX_SPOT_LIGHTS];
float4 _SpotLightColorAngleOffset[MAX_SPOT_LIGHTS];

// Worst-case DDA step count: a ray crosses at most BGI_GRID cells per axis, so 3*BGI_GRID steps cover
// the whole grid corner-to-corner. This depends only on the resolution (not voxel size/aspect), so it
// is a compile-time constant rather than a uniform.
#define BGI_MAX_RAY_STEPS (BGI_GRID * 3u)

// Far-air gather skip cutoff (city-block voxels): air farther than this from any surface is never
// read by the fragment or the blur, so CSGather skips its ray casts. Must be < BGI_MAX_AIR_DIST so the
// distance stored for cutoff voxels is exact (near voxels resolve within this many relaxation passes).
#define BGI_GATHER_MAX_AIR_DIST 4u

// Procedural stochastic sample (replaces the blue-noise texture, keeps the system textureless):
// per-voxel spatial decorrelation via a hash, walked by the R2 low-discrepancy sequence
// (Cranley-Patterson rotation) so each voxel's sequence converges low-discrepancy.
//
// `sampleIndex` is the GLOBAL ray ordinal for this voxel - how many rays it has already gathered,
// plus this ray's position within the frame - NOT the frame number. That is what makes quality
// independent of samples-per-frame, which is the whole contract of the setting: 500 rays at 1/frame
// walks indices 0..499 over 500 frames, and 500 rays at 50/frame walks 0..49, 50..99, ... over 10
// frames. Same 500 points, so the same converged field, exactly rather than approximately.
//
// The previous form seeded the per-voxel base from the ray's index WITHIN the frame and rotated by
// the frame counter, so the point set was a function of how the budget was sliced: at 1 ray/frame a
// voxel drew from a single base forever, at 50 it drew from 50. Measured on Sponza, that put the
// converged spf=1 and spf=50 fields 27.9% apart per voxel against a 3.6% run-to-run control, and
// spf=1 was the wrong one (27.7% from a high-budget reference, where spf=50 sat at 3.1%).
float2 GiSampleNoise(uint3 id, uint sampleIndex)
{
    uint seed = (id.x * 73856093u) ^ (id.y * 19349663u) ^ (id.z * 83492791u);
    float2 base = float2(HashTo01(seed), HashTo01(seed ^ 0x9e3779b9u));
    float2 r2 = frac(float(sampleIndex) * float2(0.7548776662, 0.5698402909));
    return frac(base + r2);
}

// ----------------------------------------------------------
// 3D-DDA (Amanatides-Woo) through the occupancy buffer. The world-space ray direction is mapped
// into grid space (divide by per-axis voxel size) so the cell walk is correct for non-cubic
// voxels; because the world dir is unit length the marched t comes out in WORLD units, so
// maxDist is a world distance (light distance / volume diagonal). Steps off the origin cell first
// (so a voxel never self-occludes), stops at the first solid cell or past maxDist. Returns 1 on a
// solid hit (hitCell valid), else 0.
// ----------------------------------------------------------
// Sub-voxel origin variant: `gridPos` is in VOXEL units (cell index + fraction), so a ray can start
// anywhere inside a cell rather than only at its centre. That is what lets sun visibility become an
// area fraction instead of a single yes/no sampled at the centre.
int MarchOccupancyFrom(float3 gridPos, float3 worldDir, float maxDist, out int3 hitCell)
{
    int3 cell = (int3)floor(gridPos);
    hitCell = cell;
    float3 inCell = gridPos - (float3)cell;         // 0..1 position within the origin cell
    float3 d = worldDir / max(_BgiVoxelSize, 1e-6); // world dir -> grid-space dir
    int3 step = int3(d.x >= 0 ? 1 : -1, d.y >= 0 ? 1 : -1, d.z >= 0 ? 1 : -1);
    float3 inv = 1.0 / max(abs(d), 1e-6);
    // World distance from the ORIGIN to the first cell boundary on each axis. At inCell = 0.5 this is
    // inv * 0.5 - bit-for-bit what the centre-origin march used before.
    float3 toBoundary = float3(d.x >= 0 ? 1.0 - inCell.x : inCell.x,
                               d.y >= 0 ? 1.0 - inCell.y : inCell.y,
                               d.z >= 0 ? 1.0 - inCell.z : inCell.z);
    float3 tMax = inv * toBoundary;
    float3 tDelta = inv;       // world distance to cross one full voxel on each axis

    [loop]
    for (uint s = 0u; s < BGI_MAX_RAY_STEPS; s++) {
        float tCross;
        if (tMax.x < tMax.y) {
            if (tMax.x < tMax.z) { tCross = tMax.x; cell.x += step.x; tMax.x += tDelta.x; }
            else                 { tCross = tMax.z; cell.z += step.z; tMax.z += tDelta.z; }
        } else {
            if (tMax.y < tMax.z) { tCross = tMax.y; cell.y += step.y; tMax.y += tDelta.y; }
            else                 { tCross = tMax.z; cell.z += step.z; tMax.z += tDelta.z; }
        }
        if (tCross > maxDist) return 0;         // reached the light / max range before a hit
        if (!BgiInBounds(cell)) return 0;       // escaped the grid -> sky/miss
        if (BgiSolidBit(BgiSlot((uint3)cell))) { hitCell = cell; return 1; }
    }
    return 0;
}

// Centre-origin march, unchanged for every existing caller (gather rays, point/spot shadow rays).
int MarchOccupancy(int3 start, float3 worldDir, float maxDist, out int3 hitCell)
{
    return MarchOccupancyFrom((float3)start + 0.5, worldDir, maxDist, hitCell);
}

// ----------------------------------------------------------
// P7 - the SOLVE's occlusion queries against the hi-res occupancy.
//
// Selected at runtime by _BgiSolveMarchLevel rather than a keyword: the choice is uniform across the
// dispatch and the branch sits OUTSIDE the march loop, so it costs nothing measurable, and having all
// three levels resident is what makes a level-to-level A/B a uniform write instead of a recompile.
//   0 = coarse   - the 32^3 _Occupancy march, unchanged; this is the pre-P7 behaviour
//   1 = flat     - Amanatides-Woo straight over _OccupancyHi
//   2 = twoLevel - the coarse walk over _OccupancyTraversal, descending into _OccupancyHi only in
//                  cells that hold geometry
// ----------------------------------------------------------
#define BGI_MARCH_COARSE   0
#define BGI_MARCH_FLAT     1
#define BGI_MARCH_TWOLEVEL 2
int _BgiSolveMarchLevel;

// 1 = CSBlur's shell dilation refuses air that a surface grew into (see _OccupancyGrown); 0 = the
// pre-gate behaviour. A uniform rather than a keyword for the same reason as the march level above:
// the branch is uniform across the dispatch and sits outside the 26-neighbour walk, so both paths
// stay resident and the comparison is a write instead of a recompile. Display-side only - the buffer
// is read by nothing that traces a ray, so the raster and the air field are identical either way.
int _BgiGrownGate;

// Hi-res cells per lighting cell, per axis (2, 4 or 8 for occ 64/128/256 at giResolution 32).
#define BGI_OCC_PER_CELL_LOG2 ((int)(BGI_OCC_GRID_LOG2 - BGI_GRID_LOG2))

// THE ORIGIN CELL IS EXEMPT, AT LIGHTING RESOLUTION - not at hi-res.
//
// The coarse march steps off its origin cell so a surface voxel does not occlude its own rays. Lifted
// naively to hi-res that exemption shrinks to one 0.17 m cell, and a gather ray leaving the CENTRE of
// a solid 0.68 m wall voxel now starts inside its own geometry and hits it on step one - every
// surface goes black. So the exemption stays stated in LIGHTING cells: skip any hi-res hit whose
// parent lighting cell is the one the ray started in.
//
// This is deliberately not a fix for the origin cell's interior detail. What P7 buys is accuracy
// BEYOND the origin cell, which is where the 0.22 m curtain that used to cast a 0.68 m shadow lives.
int MarchOccupancyHiHit(float3 hiGridPos, float3 worldDir, float maxDist, int3 exemptCell, out int3 hitCellHi)
{
    int3 cell = (int3)floor(hiGridPos);
    hitCellHi = cell;
    float3 inCell = hiGridPos - (float3)cell;
    float3 hiVox = _BgiGridSize / (float)BGI_OCC_GRID;
    float3 d = worldDir / max(hiVox, 1e-6);
    int3 step = int3(d.x >= 0 ? 1 : -1, d.y >= 0 ? 1 : -1, d.z >= 0 ? 1 : -1);
    float3 inv = 1.0 / max(abs(d), 1e-6);
    float3 toBoundary = float3(d.x >= 0 ? 1.0 - inCell.x : inCell.x,
                               d.y >= 0 ? 1.0 - inCell.y : inCell.y,
                               d.z >= 0 ? 1.0 - inCell.z : inCell.z);
    float3 tMax = inv * toBoundary;
    float3 tDelta = inv;

    [loop]
    for (uint s = 0u; s < BGI_MAX_OCC_RAY_STEPS; s++) {
        float tCross;
        if (tMax.x < tMax.y) {
            if (tMax.x < tMax.z) { tCross = tMax.x; cell.x += step.x; tMax.x += tDelta.x; }
            else                 { tCross = tMax.z; cell.z += step.z; tMax.z += tDelta.z; }
        } else {
            if (tMax.y < tMax.z) { tCross = tMax.y; cell.y += step.y; tMax.y += tDelta.y; }
            else                 { tCross = tMax.z; cell.z += step.z; tMax.z += tDelta.z; }
        }
        if (tCross > maxDist) return 0;
        if (!BgiOccInBounds(cell)) return 0;
        if (all((cell >> BGI_OCC_PER_CELL_LOG2) == exemptCell)) continue;
        if (BgiHiSolidBit((uint3)cell)) { hitCellHi = cell; return 1; }
    }
    return 0;
}

// Descend into ONE lighting cell known to hold geometry, from the point the ray entered it.
// `hiEntry` is that entry point in hi-res grid units; the walk stops the moment it leaves the cell.
// The 4x4x4 block words are held in registers and reloaded only when the walk crosses a block
// boundary, which at occ/grid ratios 2 and 4 never happens (the whole lighting cell is inside one
// block) and at ratio 8 happens at most seven times.
int DescendLightingCell(float3 hiEntry, int3 step, float3 inv, float tEntry, float maxDist,
                        int3 lightingCell, out int3 hitCellHi)
{
    int3 cell = (int3)floor(hiEntry);
    hitCellHi = cell;
    // The entry point can land a hair outside on a boundary; clamp into the cell we know we entered.
    int3 lo = lightingCell << BGI_OCC_PER_CELL_LOG2;
    int3 hi = lo + ((1 << BGI_OCC_PER_CELL_LOG2) - 1);
    cell = clamp(cell, lo, hi);

    int3 block = cell >> 2;
    uint w0, w1; BgiHiBlockWords(block, w0, w1);

    // Single-exit, like MarchSolidFrom: an early return whose value feeds the caller's branch draws a
    // "use of potentially uninitialized variable" from the D3D and SPIR-V compilers.
    int result = 0;
    // FULLY SOLID lighting cell - the common case inside a thick wall, and the one the outer walk
    // cannot answer on its own. Every cell is a hit, so the entry cell is the hit and the inner DDA
    // (its setup and up to 3*ratio steps) is skipped entirely.
    // The FIRST cell is tested at all, unlike the outer march: the ray entered this lighting cell
    // here, and the cell it entered is a legitimate occluder. The origin exemption is the outer walk's
    // job.
    if ((w0 & w1) == 0xffffffffu || BgiHiSolidInBlock(w0, w1, cell)) {
        hitCellHi = cell;
        result = 1;
    } else {
        // step/inv are the HI-RES DDA constants, computed once by the caller: they depend only on the
        // ray direction, so recomputing them per descent (six divides) cost more than the walk.
        float3 inCell = hiEntry - (float3)cell;
        float3 toBoundary = float3(step.x > 0 ? 1.0 - inCell.x : inCell.x,
                                   step.y > 0 ? 1.0 - inCell.y : inCell.y,
                                   step.z > 0 ? 1.0 - inCell.z : inCell.z);
        float3 tMax = tEntry + inv * saturate(toBoundary);
        float3 tDelta = inv;

        // 3 * cells-per-axis bounds the walk through one lighting cell, exactly as 3 * grid bounds a
        // walk through the whole volume.
        [loop]
        for (int s = 0; s < 3 * (1 << BGI_OCC_PER_CELL_LOG2); s++) {
            float tCross;
            if (tMax.x < tMax.y) {
                if (tMax.x < tMax.z) { tCross = tMax.x; cell.x += step.x; tMax.x += tDelta.x; }
                else                 { tCross = tMax.z; cell.z += step.z; tMax.z += tDelta.z; }
            } else {
                if (tMax.y < tMax.z) { tCross = tMax.y; cell.y += step.y; tMax.y += tDelta.y; }
                else                 { tCross = tMax.z; cell.z += step.z; tMax.z += tDelta.z; }
            }
            if (tCross > maxDist) break;
            if (any(cell < lo) || any(cell > hi)) break;   // left the cell - the outer walk resumes
            int3 nb = cell >> 2;
            if (any(nb != block)) { block = nb; BgiHiBlockWords(block, w0, w1); }
            if (BgiHiSolidInBlock(w0, w1, cell)) { hitCellHi = cell; result = 1; break; }
        }
    }
    return result;
}

// Two-level march. Structurally the COARSE march - same walk, same origin-cell exemption, same step
// bound - with the solidity test replaced by "does this lighting cell hold any geometry, and if so
// where exactly". `gridPos` is in LIGHTING grid units, like MarchOccupancyFrom.
//
// The upper level is _OccupancyTraversal, not _Occupancy: it is the OR-downsample of the hi-res
// raster, so it is conservative about the hi-res field. Using _Occupancy here would skip the ~1,130
// Sponza cells that hold hi-res geometry the 32^3 raster never saw.
int MarchOccupancyTwoLevel(float3 gridPos, float3 worldDir, float maxDist, out int3 hitCellHi)
{
    int3 cell = (int3)floor(gridPos);
    int3 exempt = cell;
    hitCellHi = cell << BGI_OCC_PER_CELL_LOG2;
    float3 inCell = gridPos - (float3)cell;
    float3 d = worldDir / max(_BgiVoxelSize, 1e-6);
    int3 step = int3(d.x >= 0 ? 1 : -1, d.y >= 0 ? 1 : -1, d.z >= 0 ? 1 : -1);
    float3 inv = 1.0 / max(abs(d), 1e-6);
    float3 toBoundary = float3(d.x >= 0 ? 1.0 - inCell.x : inCell.x,
                               d.y >= 0 ? 1.0 - inCell.y : inCell.y,
                               d.z >= 0 ? 1.0 - inCell.z : inCell.z);
    float3 tMax = inv * toBoundary;
    float3 tDelta = inv;
    float ratio = (float)(1 << BGI_OCC_PER_CELL_LOG2);
    // Hi-res DDA constants, derived from the coarse ones rather than recomputed: the occupancy grid
    // is the lighting grid subdivided by `ratio`, so its cells are `ratio` times smaller and the
    // per-cell crossing distance is `ratio` times shorter. Same `step` - direction is unchanged.
    float3 invHi = inv / ratio;

    [loop]
    for (uint s = 0u; s < BGI_MAX_RAY_STEPS; s++) {
        float tCross;
        if (tMax.x < tMax.y) {
            if (tMax.x < tMax.z) { tCross = tMax.x; cell.x += step.x; tMax.x += tDelta.x; }
            else                 { tCross = tMax.z; cell.z += step.z; tMax.z += tDelta.z; }
        } else {
            if (tMax.y < tMax.z) { tCross = tMax.y; cell.y += step.y; tMax.y += tDelta.y; }
            else                 { tCross = tMax.z; cell.z += step.z; tMax.z += tDelta.z; }
        }
        if (tCross > maxDist) return 0;
        if (!BgiInBounds(cell)) return 0;
        if (all(cell == exempt)) continue;
        if (!BgiTraversalSolidBit(BgiSlot((uint3)cell))) continue;   // empty -> skip 2^3..8^3 cells untested
        // Entry point into this lighting cell, in hi-res units. tCross is a WORLD distance and the
        // direction is unit, so the position is gridPos + dir/voxelSize * tCross.
        float3 entry = (gridPos + d * tCross) * ratio;
        if (DescendLightingCell(entry, step, invHi, tCross, maxDist, cell, hitCellHi)) return 1;
    }
    return 0;
}

// The one entry point the solve's occlusion queries call. Takes and returns LIGHTING-grid
// coordinates whatever level is running, so switching levels cannot change a caller's index math.
// Single-exit and fully initialised on purpose, like SunVisibilityStratified below: an early return
// feeding the caller's branch makes the D3D and SPIR-V compilers report "use of potentially
// uninitialized variable" for the out-param even when every path assigns it.
int MarchSolidFrom(float3 gridPos, float3 worldDir, float maxDist, out int3 hitCell)
{
    hitCell = (int3)floor(gridPos);
    int3 hiHit = hitCell << BGI_OCC_PER_CELL_LOG2;
    int hit = 0;
    if (_BgiSolveMarchLevel == BGI_MARCH_COARSE) {
        hit = MarchOccupancyFrom(gridPos, worldDir, maxDist, hitCell);
    } else {
        if (_BgiSolveMarchLevel == BGI_MARCH_FLAT) {
            float ratio = (float)(1 << BGI_OCC_PER_CELL_LOG2);
            hit = MarchOccupancyHiHit(gridPos * ratio, worldDir, maxDist, (int3)floor(gridPos), hiHit);
        } else {
            hit = MarchOccupancyTwoLevel(gridPos, worldDir, maxDist, hiHit);
        }
        hitCell = hiHit >> BGI_OCC_PER_CELL_LOG2;
    }
    return hit;
}

int MarchSolid(int3 start, float3 worldDir, float maxDist, out int3 hitCell)
{
    return MarchSolidFrom((float3)start + 0.5, worldDir, maxDist, hitCell);
}

inline half BgiSunRay(int3 cell, float3 offset)
{
    int3 hit;
    return MarchSolidFrom((float3)cell + offset, _DirectLightDir, BGI_MAX_RAY_DIST, hit) ? 0.0h : 1.0h;
}

// Sun visibility as an AREA FRACTION of the voxel, averaged over `n` stratified interior origins.
//
// One ray from the centre can only ever answer 0 or 1, and neither CSBlur's 7-tap box nor the
// fragment's trilinear tap can recover where inside the voxel the shadow edge actually fell - they
// only widen a binary edge, which is the one-voxel staircase the Baked mode shows. Sampling the
// voxel's volume captures that position, and the value it produces is what interpolation wants.
//
// Offsets are deterministic per voxel, so the result is stable frame to frame and needs no temporal
// accumulation: this mode stays instant when the sun moves.
// Single-exit and fully initialised on purpose: an early return feeding the caller's branch makes
// Vulkan/SPIR-V report "use of potentially uninitialized variable" even when every path assigns.
half SunVisibilityStratified(int3 cell, int n)
{
    half lit = 0.0h;
    if (n <= 1) {
        lit = BgiSunRay(cell, 0.5); // exactly the original centre ray
    } else {
        float3 jitterBase = BgiVoxelJitterBase(cell);
        [loop]
        for (int s = 0; s < n; s++)
            lit += BgiSunRay(cell, frac(jitterBase + BGI_R2_3D * (float)s));
        lit /= (half)n;
    }
    return lit;
}



// The surface normal for a solid voxel: always the per-voxel baked value from _Surface (one read +
// unpack). Filled at bake by CSBuildSurface (gradient) or the voxelizer (mesh); never zero, so the
// callers' 0-fallback is dead but harmless. The runtime never computes the gradient anymore.
float3 SurfaceNormal(int3 c)
{
    return BgiSurfaceNormal(_Surface[BgiSlot((uint3)c)]);
}

// Evaluate the environment ambient-probe SH in a direction (matches Unity's ShadeSH9). The SH
// coefficients are fp32 uniforms so the dot products stay fp32; the resulting radiance is narrowed
// once, since it is only ever fp16-packed into the fields anyway.
half3 EvalEnvSH(float3 n)
{
    float4 vA = float4(n, 1.0);
    float3 l = float3(dot(_EnvShAr, vA), dot(_EnvShAg, vA), dot(_EnvShAb, vA)); // L0 + L1
    float4 vB = n.xyzz * n.yzzx;
    l += float3(dot(_EnvShBr, vB), dot(_EnvShBg, vB), dot(_EnvShBb, vB));       // L2 (4 of 5)
    l += _EnvShC.rgb * (n.x * n.x - n.y * n.y);                                 // L2 (5th)
    return (half3)max(0.0, l);
}

// Like SanitizeColor, this is a NARROWING POINT: it takes fp32 and returns fp16. The input is the
// reach-boosted radiance, which is a stored field value times a user multiplier and so can exceed
// fp16's 65504 in an extreme scene - doing the luminance test and the rescale in fp32 and clamping
// to the field ceiling means the narrowing can never produce an Inf.
half3 ClampFirefly(float3 color, half maxLuminance)
{
    // Single return point (an early return lowers to a return-slot variable that the WebGPU
    // validator flags as possibly uninitialized).
    float luma = GetRec709Luminance(color);
    float maxLum = (float)maxLuminance;
    float scale = (maxLum > 0.0 && luma > maxLum) ? (maxLum / max(luma, 1e-6)) : 1.0;
    return (half3)min(color * scale, 60000.0);
}

// Keep the fields finite and non-negative. (c < 1e8) is false for both +Inf and NaN, so they map
// to 0 without isnan() - which fast-math / d3d11 /Gis may strip, defeating the guard. This stops a
// poisoned voxel from spreading through the bounce + blur and rendering black; it recovers next frame.
//
// This is also the NARROWING POINT into the fp16 fields, and the order matters: the test and the
// clamp run in fp32, so a value between 65504 and 1e8 is clamped to 60000 rather than becoming an
// fp16 Inf (which the guard would then map to black - a voxel flashing off instead of saturating).
// The clamped result is representable in half by construction, so the return is lossless.
half3 SanitizeColor(float3 c)
{
    return (c < 1e8) ? (half3)clamp(c, 0.0, 60000.0) : half3(0.0h, 0.0h, 0.0h);
}

// Direct lighting at a surface voxel, with DDA shadow rays and an N.L cosine term. `sunVis` returns
// the main directional light's raw visibility (1 lit, 0 shadowed) so the fragment can read a cheap
// baked voxel sun-shadow straight from the radiance field's spare w channel (see BgiSampleSunShadow).
// The visibility / N.L / cone / attenuation terms are all bounded unitless values and run in fp16.
// `total` stays fp32 on purpose: it is the one accumulation fed by raw light-colour uniforms rather
// than by the fp16-packed fields, so a bright light at close range could exceed 65504 here - and
// SanitizeColor maps an Inf to BLACK, which would flash a voxel off instead of clamping it.
// `radSlot` is this FACE's radiance slot (BgiRadianceSlot), needed only by the Temporal sun-shadow
// estimator, which folds this frame's sample into the value that face stored last frame. Passing the
// resolved slot rather than re-deriving it keeps the two sides of a thin wall from reading each
// other's history - each face accumulates its own visibility.
float3 GetDirectLight(int3 cell, float3 normal, int3 shadowStep, uint radSlot, out half sunVis)
{
    float3 voxelCenter = BgiVoxelCenter((uint3)cell);
    int3 hit;

    // Cast the shadow rays from the AIR voxel one step off the surface, not from this solid cell: a
    // surface voxel's ray toward an overhead light otherwise immediately hits the solid voxel that
    // continues the wall ABOVE it, self-shadowing every row but the top.
    //
    // WHICH neighbour was decided at bake by BgiPickShadowOrigin and is handed in by the caller, which
    // reads it from the surface word. That keeps the search out of this kernel: CSInject runs every
    // solve frame, and there the cost is per-WAVE, not per-voxel - one corner voxel among 64 threads
    // makes the whole wave walk the scan.
    //
    // The guard stays, because the step can be wrong at the point of USE even when the bake was right:
    // the BACK face of a two-sided voxel negates it, and a zeroed (never-baked) word decodes to
    // (-1,-1,-1). Falling back to the cell marches straight into solid and reads fully shadowed, which
    // is the correct answer for an enclosed interior.
    int3 shadowStart = cell + shadowStep;
    if (!BgiInBounds(shadowStart) || BgiSolidBit(BgiSlot((uint3)shadowStart)))
        shadowStart = cell;


    // Sun. March the visibility toward the sun UNCONDITIONALLY (not only when this face points at the
    // sun): the baked shadow read interpolates this per-voxel scalar across the surface, so it needs a
    // real value on faces that don't themselves face the sun (as interpolation neighbours, and for
    // normal-mapped pixels whose shading normal faces the sun while the geometric voxel doesn't). A
    // face pointing away self-occludes - its own geometry blocks the ray - so it marches to ~0, the
    // physically correct "in shadow from the sun" (rather than a defaulted 1 = lit).
    //
    // Supersampled, unlike the air probe's ray CSGather used to cast (removed - see there). This one
    // is ALIVE: it scales the direct sun term this voxel then BOUNCES. Dropping it to a single centre
    // ray measured 4.90% brighter overall on Sponza (96% of pixels, max 15/255), so the area fraction
    // is doing real work even though the value it produces is collapsed into one radiance number - a
    // centre ray reads "lit" too often near a shadow boundary.
    //
    // The Temporal estimator that used to sit here is gone. It folded one jittered ray per frame into
    // the w channel of _Radiance to converge on the same fraction for no extra rays - worth it when
    // the solve produced the DISPLAYED shadow, pointless once P6 moved that to CSSunVisibility, and it
    // cost a _Radiance read per solid voxel per frame that CSInject does not otherwise need.
    float3 total = 0;
    sunVis = SunVisibilityStratified(shadowStart, _BgiInjectSunSamples);
    half ndlSun = saturate((half)dot(normal, _DirectLightDir));
    if (ndlSun > 0.0h)
        total += _DirectLightColor.rgb * (float)(ndlSun * sunVis);

    // Point lights
    uint pc = min(_PointLightCount, (uint)MAX_POINT_LIGHTS);
    [loop]
    for (uint p = 0u; p < pc; p++) {
        float4 posRange = _PointLightPositionRange[p];
        float3 toLight = posRange.xyz - voxelCenter;
        float distSq = dot(toLight, toLight);
        float rangeSq = posRange.w * posRange.w;
        if (distSq <= 1e-6 || distSq >= rangeSq) continue;
        float invD = rsqrt(distSq);
        float3 L = toLight * invD;
        half ndl = saturate((half)dot(normal, L));
        if (ndl <= 0.0h) continue;
        float worldDist = distSq * invD; // = sqrt(distSq), distance to the light
        half vis = MarchSolid(shadowStart, L, worldDist, hit) ? 0.0h : 1.0h;
        total += _PointLightColor[p].rgb * (float)(ndl * vis * GetLightRangeAttenuation(distSq, rangeSq));
    }

    // Spot lights
    uint sc = min(_SpotLightCount, (uint)MAX_SPOT_LIGHTS);
    [loop]
    for (uint sIdx = 0u; sIdx < sc; sIdx++) {
        float4 posRange = _SpotLightPositionRange[sIdx];
        float3 toLight = posRange.xyz - voxelCenter;
        float distSq = dot(toLight, toLight);
        float rangeSq = posRange.w * posRange.w;
        if (distSq <= 1e-6 || distSq >= rangeSq) continue;
        float invD = rsqrt(distSq);
        float3 L = toLight * invD;
        half ndl = saturate((half)dot(normal, L));
        if (ndl <= 0.0h) continue;
        float4 dirAngleScale = _SpotLightDirectionAngleScale[sIdx];
        float4 colAngleOffset = _SpotLightColorAngleOffset[sIdx];
        // Formed in fp32 (the angle scale is large for a narrow cone), narrowed once.
        half cone = (half)saturate(dot(-L, dirAngleScale.xyz) * dirAngleScale.w + colAngleOffset.a);
        if (cone <= 0.0h) continue;
        float worldDist = distSq * invD; // = sqrt(distSq), distance to the light
        half vis = MarchSolid(shadowStart, L, worldDist, hit) ? 0.0h : 1.0h;
        total += colAngleOffset.rgb * (float)(ndl * vis * (cone * cone) * GetLightRangeAttenuation(distSq, rangeSq));
    }

    return total;
}

// One gather ray's contribution from `fromCell` in world direction `dir`: the room-lit radiance of
// the surface it hits (if it crossed that surface's FRONT/lit face), the ambient-floor "interior
// color" for a back-face hit, or the environment sky if the ray escapes the grid. Shared by the air
// probe (omnidirectional) and the surface incident gather (front hemisphere).
//
// Front/back is decided by the hit voxel's occupancy normal. A THIN SLAB with air on BOTH sides
// (a 1-voxel floor/ceiling/wall) has an AMBIGUOUS (zero) occupancy normal; inject computed its
// radiance with an UP fallback normal, so we test against UP here too for consistency: a ray
// arriving from above (dot(dir,up) < 0 = it crossed the lit top face) reads the radiance, while the
// dark underside and horizontally-hit thin vertical walls (dot(dir,up) ~ 0) stay rejected -> ambient
// floor (still blocks the thin-wall leak this originally guarded). Without this, a thin SUNLIT FLOOR
// emits bright radiance but contributes NOTHING to the air above it (bright floor, black irradiance).
//
// `reachBoost` (>= 1) is a non-physical distance fill: a surface hit is weighted up toward reachBoost
// as its distance approaches the grid diagonal, so bright surfaces seen from deep in shadow spread
// more light in. Pass 1 for the physical result (the surface bounce gather does, to stay stable).
//
// A ray that ESCAPES the grid returns the environment SH in its direction: the sky acts as an AREA
// light, so it belongs in the averaged estimate (unbiased at any sample count). The SUN is handled
// separately (deterministic visibility ray in CSGather), so no sun lobe here.
// Everything this returns comes out of (or goes straight back into) the fp16-packed fields, so the
// whole radiance path is half; only the ray geometry (positions, hit distance) stays fp32.
half3 GatherRayRadiance(int3 fromCell, float3 dir, half reachBoost)
{
    int3 hit;
    half3 result;
    if (MarchSolid(fromCell, dir, BGI_MAX_RAY_DIST, hit)) {
        // A HI-RES hit can land in a lighting cell the 32^3 raster never marked solid - 1,130 of
        // Sponza's 13,069 occupied cells are hi-res-only (the containment measurement in the plan).
        // Those cells have no _Surface and no _Radiance: they are real geometry the LIGHTING grid does
        // not carry. Reading their slots would return a zeroed surface word (normal 0 -> "up") and
        // whatever the radiance buffer last held there, which for an air cell is nothing.
        //
        // The ambient floor is the honest answer: the ray is blocked - that part IS new information
        // and is the whole point of marching finer - but the occluder's outgoing radiance is unknown,
        // and the ambient floor is already this function's value for "blocked by something whose lit
        // side we cannot see". Resolving it properly is P8's job, not this phase's.
        bool lightingCellCarriesIt = BgiSolidBit(BgiSlot((uint3)hit));

        // One load of the hit's surface word covers both the normal and the flags (SurfaceNormal
        // would have fetched exactly this), so the emissive test below is free.
        uint hitSurface = _Surface[BgiSlot((uint3)hit)];
        float3 hitNormal = BgiSurfaceNormal(hitSurface);
        float3 faceN = (dot(hitNormal, hitNormal) > 1e-6) ? hitNormal : float3(0, 1, 0); // ambiguous -> up (matches inject)
        // A baked-LIGHT voxel is an omnidirectional emitter, not a surface: it has no lit face, so it
        // skips the front/back test and reads back its radiance from whichever side the ray came.
        //
        // TWO-SIDED voxels also pass: a sub-voxel wall genuinely HAS a face here, it is just not the
        // one the stored normal describes, and inject gave it its own slot. Rejecting it (the old
        // behaviour, and still the behaviour for a real interior back-face) is what made thin walls
        // read black on an arbitrary side. The slot select below picks the side by the face the ray
        // crossed - outward normal -dir - so the dark underside can never return the lit top's value.
        bool twoSided = _BgiRadianceDirs > 1 && BgiSurfaceIsTwoSided(hitSurface);
        if (lightingCellCarriesIt && (BgiSurfaceIsEmissive(hitSurface) || dot(dir, faceN) < 0.0 || twoSided)) {
            half3 rad; half w;
            BgiUnpackRgbH(_Radiance[BgiRadianceSlot(BgiSlot((uint3)hit), -dir, faceN, hitSurface)], rad, w);
            // Distance-weighted reach fill (t = hit distance / grid diagonal, clamped 0..1). Applied
            // BEFORE the firefly clamp so a boosted-then-bright sample still can't spike.
            half t = (half)saturate(length(BgiVoxelCenter((uint3)hit) - BgiVoxelCenter((uint3)fromCell)) / BGI_MAX_RAY_DIST);
            // The boost itself is fp32 (see ClampFirefly): a near-ceiling stored radiance times the
            // multiplier is the one product here that could leave fp16 range.
            result = ClampFirefly((float3)rad * (float)lerp(1.0h, reachBoost, t), (half)_GiFireflyClamp);
        } else {
            result = (half3)_AmbientFloor;
        }
    } else {
        result = EvalEnvSH(dir); // escaped -> sky (area light, averaged like any other sample)
    }
    return result;
}

[numthreads(64, 1, 1)]
void CSClear(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= BGI_COUNT) return;
    BgiClearRadiance(_FieldOffset + i);
    BgiClearIrradiance(_FieldOffset + i); // all buckets of _Irradiance and _IrradianceBlur
}

// ----------------------------------------------------------
// INJECT: outgoing radiance for solid voxels.
// ----------------------------------------------------------
[numthreads(64, 1, 1)]
void CSInject(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= BGI_COUNT) return;

    // Test the bitfield first so air voxels never touch the (cold) material buffer; only solid
    // voxels read their albedo/emission - inject is the sole consumer of _Material.
    if (!BgiSolidBit(_FieldOffset + i)) { BgiClearRadiance(_FieldOffset + i); return; }
    uint mat = _Material[_FieldOffset + i];

    int3 cell = (int3)BgiCoord(i);
    uint surfWord = _Surface[_FieldOffset + i];
    float3 normal = SurfaceNormal(cell);
    if (dot(normal, normal) < 1e-6) normal = float3(0, 1, 0); // ambiguous -> harmless up for direct/bounce
    half3 albedo = BgiAlbedo(mat);
    // Emission decode stays fp32: the log curve spans up to EMISSION_INTENSITY_MAX (1024) and
    // exp2/log2 are fp32 ops on every backend anyway.
    float emissionIntensity = DecodeEmissionIntensityFrom8Bit(BgiEmission8(mat));
    float3 emissive = (float3)albedo * emissionIntensity;

    // Bounce arriving at this surface = its incident irradiance, gathered over the FRONT hemisphere
    // by CSGather (previous frame) and stored in this solid voxel's own _Irradiance slot. Reading
    // that - instead of the adjacent AIR voxel's OMNIDIRECTIONAL probe - means the surface no longer
    // sees its own outgoing radiance (that probe's back hemisphere is this very wall), which was an
    // F_ii self-illumination loop: energy the wall emits came back as "incident" and re-lit it. It
    // also restores directionality, so light from an opening propagates inward instead of averaging
    // flat against dark neighbours (helps cavern/indirect fill).
    // In Cube this reconstructs the FRONT face's share from the buckets (n^2 weights); outside it,
    // it is the single stored value. Either way the back face below asks for its own direction, so
    // the two sides of a thin wall no longer re-emit each other's incident light.
    half bwSun;
    half3 bounce = BgiGatheredIrradiance(_FieldOffset + i, normal, bwSun);

    // Clamp reflectance below 1: with albedo == 1 the bounce feedback is a lossless cavity that
    // diverges to Inf/NaN ("black plague"). Still cheap insurance for concave corners even though the
    // front-hemisphere gather removed the dominant self-term. Emission is unaffected (added separately).
    half3 safeAlbedo = min(albedo, 0.95h);

    // FRONT face: the stored normal's side.
    // Stash the sun visibility in the radiance's spare w half - the fragment reads it as a cheap,
    // pre-marched voxel sun-shadow (interpolated across the surface face), no per-pixel ray needed.
    uint frontSlot = BgiRadianceSlot(_FieldOffset + i, normal, normal, surfWord);
    half sunVis;
    // Sun-ray origin, baked into the surface word by CSBuildSurface. One decode serves both faces: the
    // back face below negates it, which is right for the only voxels that HAVE a back face - a
    // sub-voxel wall, whose two sides are air along opposite directions by definition.
    int3 originStep = BgiShadowOriginStep(surfWord);
    float3 direct = GetDirectLight(cell, normal, originStep, frontSlot, sunVis);
    half3 outgoing = SanitizeColor(emissive + (float3)safeAlbedo * (direct + (float3)bounce));
    _Radiance[frontSlot] = BgiPackRgb(outgoing, sunVis);

    // BACK face of a sub-voxel wall. Both of its faces share this cell, so without a second slot the
    // gather's front/back test rejects everything arriving at the far side and falls back to the
    // (black) ambient floor - a thin wall goes dark on whichever side the voxelizer happened not to
    // store. Running the same computation with -normal gives that side its OWN direct light and its
    // OWN sun-visibility ray (GetDirectLight steps its shadow start the other way), which is the part
    // that actually differs: a sunlit floor slab's top is lit and its underside is not.
    // Skipped in Single, where there is nowhere to put it.
    if (_BgiRadianceDirs > 1 && BgiSurfaceIsTwoSided(surfWord)) {
        float3 backN = -normal;
        uint backSlot = BgiRadianceSlot(_FieldOffset + i, backN, normal, surfWord);
        half backSun;
        float3 backDirect = GetDirectLight(cell, backN, -originStep, backSlot, backSun);
        // Same albedo and emission (one material per voxel), but its OWN incident irradiance: reusing
        // the front's `bounce` here re-emits the lit side's light out of the dark side, which measured
        // +150% in Sponza's lower gallery - the slab's underside glowing with the courtyard above it.
        // The second radiance slot only exists in Cube, and there the cube buckets already carry both
        // hemispheres (CSGather sends the OMNI sample for a two-sided voxel), so asking for -normal
        // reconstructs the back side's own incident light from the same buckets.
        half backBw;
        half3 backBounce = BgiGatheredIrradiance(_FieldOffset + i, backN, backBw);
        half3 backOut = SanitizeColor(emissive + (float3)safeAlbedo * (backDirect + (float3)backBounce));
        _Radiance[backSlot] = BgiPackRgb(backOut, backSun);
    }
}

// ----------------------------------------------------------
// GATHER: 1+ rays/frame per voxel, with the temporal resolve fused in (in-place EMA). Two roles by
// occupancy: AIR voxels build the OMNIDIRECTIONAL irradiance probe the fragment read samples; SOLID
// (surface) voxels build their INCIDENT irradiance over the FRONT hemisphere (cosine-weighted around
// the surface normal), stored in the same buffer slot and read by CSInject as the surface's `bounce`.
// The surface gather runs here (not in CSInject) so it reads this frame's _Radiance from a completed
// dispatch rather than racing the same one.
// ----------------------------------------------------------
[numthreads(64, 1, 1)]
void CSGather(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= BGI_COUNT) return;

    uint3 c = BgiCoord(i);
    int3 cell = (int3)c;
    uint slot = _FieldOffset + i;
    bool solid = BgiSolidBit(slot);
    uint surf = _Surface[slot];

    // FAR-AIR GATHER SKIP: an air voxel more than a few cells from any surface is never sampled - the
    // fragment reads only the air layer ~1 voxel in front of surfaces, and CSBlur reaches one further.
    // Its omnidirectional probe would be pure cost, so skip the ray casts entirely (its stale value is
    // never read). Threshold covers the fragment's read reach + the blur's, with margin. Keyed on the
    // real occupancy bit: bits 16-23 only hold an air distance for genuinely-air voxels.
    if (!solid && BgiSurfaceAirDist(surf) > BGI_GATHER_MAX_AIR_DIST) return;

    // A baked-LIGHT voxel is solid so that it can emit and occlude, but it is NOT a surface - it is a
    // lamp hanging in the air. Gather it like the air around it (omnidirectional probe + a real sun
    // visibility) so the displayed field carries a plausible value where it sits. Treating it as a
    // surface instead leaves a hole: CSBlur zeroes every solid voxel, and the fragment's default read
    // is a raw trilinear tap with NO occupancy gate, so that zero bleeds a dark blotch onto any wall
    // the light sits near. CSBlur applies the same exception.
    bool surfaceVoxel = solid && !BgiSurfaceIsEmissive(surf);

    // For a surface voxel, gather rays into the front hemisphere around the surface normal (so they
    // leave the surface into the room and never read it back). Ambiguous normal -> up, matching inject.
    float3 normal = float3(0, 1, 0);
    if (surfaceVoxel) {
        normal = BgiSurfaceNormal(surf); // same word already loaded above
        if (dot(normal, normal) < 1e-6) normal = float3(0, 1, 0);
    }

    // BOUNCE radiance (surfaces, ambient floor, and the sky-as-area-light on escape) is a plain
    // AVERAGE: unbiased at any sample count, so samplesPerFrame only affects noise, never brightness.
    // Reach fill only on the AIR probe (display field); the surface bounce stays physical (1).
    // The accumulator stays fp32 even though each sample is fp16: a sample can legitimately be near
    // the 60000 field ceiling, and summing several of those would overflow half before the divide.
    // The mean is back in fp16 range and SanitizeColor narrows it below.
    bool cube = BgiIrradianceDirs() > 1u;
    bool twoSided = surfaceVoxel && cube && BgiSurfaceIsTwoSided(surf);
    // A two-sided surface (only Cube has a second radiance slot to serve one) gathers the FULL sphere,
    // not the front hemisphere: its two faces look into different rooms and the buckets have to carry
    // both, since the n^2 reconstruction is what separates them again at read time - that is what
    // CSInject reads back for the back face.
    bool omniSample = !surfaceVoxel || twoSided;

    float3 incoming = 0;
    // Cube buckets: cosine lobes about the six world axes. Accumulated with their own weight sums
    // rather than a fixed divisor, because the sampling distribution differs between the omni probe
    // and the cosine-hemisphere surface gather - dividing by the realised weight keeps both unbiased.
    float3 bucket[6]; float bucketW[6];
    if (cube) { [unroll] for (uint b = 0u; b < 6u; b++) { bucket[b] = 0.0; bucketW[b] = 0.0; } }

    uint sampleCount = max(_SamplesPerFrame, 1u);
    [loop]
    for (uint r = 0u; r < sampleCount; r++) {
        float2 noise = GiSampleNoise(c, _SampleBase + r);
        float3 dir = omniSample ? GetRandomDirectionFromNoise2(noise)    // air/light/two-sided: omni
                                : CosineSampleHemisphere(normal, noise); // surface: front hemisphere
        float3 L = (float3)GatherRayRadiance(cell, dir, surfaceVoxel ? 1.0h : (half)_ReachBoost);
        if (!cube) incoming += L; // the direction-less mean; Cube stores the buckets instead
        else {
            // Only the 3 axes in this direction's hemisphere get a positive cosine, so this is 3
            // weighted adds per ray, not 6.
            [unroll]
            for (uint a = 0u; a < 3u; a++) {
                float d = (a == 0u) ? dir.x : ((a == 1u) ? dir.y : dir.z);
                uint b = a * 2u + (d >= 0.0 ? 1u : 0u);
                float w = abs(d);
                bucket[b] += L * w;
                bucketW[b] += w;
            }
        }
    }
    incoming *= rcp((float)sampleCount); // this frame's estimate = mean of sampleCount samples

    // Previous value, for the irradiance progressive average below. Single-slot only: in Cube the
    // per-bucket loop at the end reads each bucket's own previous value, so there is nothing to read
    // here. (The Cube branch used to call BgiOmniIrradiance for its sun channel alone - six buffer
    // loads per air voxel for a value nothing consumed; it went with the ray below.)
    half3 oldC = 0.0h; half oldSunUnused;
    if (!cube) BgiUnpackRgbH(_Irradiance[_FieldOffset + i], oldC, oldSunUnused);
    float weight = min(1.0, _EmaWeight);

    // The air probe's sun-visibility ray USED TO LIVE HERE and is gone - it had no consumer left.
    //
    // It existed so CSBlur could mirror this scalar into the field's R16 sun-visibility texture. P6
    // replaced that: CSSunVisibility re-marches the whole shadow volume against the HI-RES occupancy,
    // CSBlur's sun-vis write was removed with it, and the blur now writes 0 into this w channel
    // unconditionally. So every one of these rays was marched, packed, and then overwritten.
    //
    // Measured on Sponza before removal: 20,828 air voxels x its sun-ray count every solve
    // frame. At hi-res (P7) that plus CSInject's own supersampling was 11.3 ms of a 47 ms solve step.
    // The removal is required to be BYTE-IDENTICAL, which is the whole argument that it was dead.
    //
    // Supersampling still matters - in CSSunVisibility (_BgiShadowTexSamples), where it is what makes the
    // on-screen shadow edge sub-voxel rather than a one-bit staircase.
    half sunVis = 0.0h;

    // Temporal PROGRESSIVE average: fold this frame's sampleCount-ray estimate into the running mean of
    // all rays gathered so far, weight = sampleCount/totalSamples (_EmaWeight from C#). The field
    // ACCUMULATES so variance ~1/totalSamples -> it keeps getting cleaner and converges (not a fixed
    // window that shimmers forever). The first frame is ~weight 1 (noisy), but CSBlur's Confidence≈0
    // hides that warm-up. The w channel carries the baked sun visibility (above), not a sample count.
    // oldC / weight are read above, where the sun visibility also needs them.
    if (!cube) {
        half3 newC = SanitizeColor(lerp((float3)oldC, incoming, weight));
        _Irradiance[_FieldOffset + i] = BgiPackRgb(newC, sunVis);
        return;
    }

    // CUBE: the same progressive average, per bucket. Each carries the sun visibility in its w so any
    // bucket can answer the shadow read without a special case for which one is "the" slot.
    //
    // A bucket that got no weight this frame (no ray landed in its hemisphere - common at low
    // samplesPerFrame, and permanent for the back hemisphere of a one-sided surface) must HOLD its
    // previous value rather than fold in a zero, which would decay it to black over frames.
    uint ibase = BgiIrradianceBase(_FieldOffset + i);
    [unroll]
    for (uint b = 0u; b < 6u; b++) {
        half3 oldB; half oldBw;
        BgiUnpackRgbH(_Irradiance[ibase + b], oldB, oldBw);
        float3 est = (bucketW[b] > 1e-4) ? bucket[b] / bucketW[b] : (float3)oldB;
        half3 newB = SanitizeColor(lerp((float3)oldB, est, weight));
        _Irradiance[ibase + b] = BgiPackRgb(newB, sunVis);
    }
}

// ----------------------------------------------------------
// BLUR: occupancy-gated box blur of the air-voxel irradiance into _IrradianceBlur (what the fragment
// read samples). Gating skips solid neighbors so dark/zero solid voxels and across-wall values can't
// bleed in. Averaging decorrelated neighbours hides the 1-ray/frame temporal shimmer. The result is
// then eased toward from the PREVIOUS _IrradianceBlur by _Confidence (0 at a light change -> 1 when
// converged), so the displayed field transitions smoothly and only fully lands once GI has converged.
// ----------------------------------------------------------
[numthreads(64, 1, 1)]
void CSBlur(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= BGI_COUNT) return;

    // Baked-LIGHT voxels are solid but are NOT surfaces (see CSGather): they fall through to the AIR
    // path below. Zeroing one here punches a black hole into the mirror texture exactly where a light
    // sits, and the fragment's default read is a raw trilinear tap with NO occupancy gate - so that
    // hole bleeds a dark blotch onto any wall the light is near. Nested rather than one &&: the solid
    // branch needs the surface word twice (emissive flag + normal), and keeping the load inside the
    // occupancy test keeps the air majority from ever touching _Surface.
    if (BgiSolidBit(_FieldOffset + i)) {
    uint sword = _Surface[_FieldOffset + i];
    if (!BgiSurfaceIsEmissive(sword)) {
        // A solid voxel's _IrradianceBlur slots hold the PREVIOUS displayed shell value (written at the
        // end of this branch), not zero. Nothing reads them as irradiance - every consumer gates on the
        // occupancy bit first (CSAverageLuminance, CSInitFineFromCoarse) - so
        // the slots are free, and they are the only place to keep the history the confidence ease needs.
        // Without it the shell had to be written raw, which is what made the first frame after a light
        // change (or any restart: EmaWeight is 1 then, so _Irradiance is a single-frame estimate - ONE
        // ray at samplesPerFrame 1) flash noise onto every corner while the air layer correctly still
        // showed the settled field.
        // Sun visibility used to be published from here too - the surface's own `_Radiance[...].w`,
        // per slab in Cube so a sub-voxel wall's two sides did not share one number. All of that moved
        // to CSSunVisibility, which re-evaluates it against the hi-res occupancy at the shadow grid.
        // The per-slab machinery went with it: at that resolution the two sides of a wall are
        // different TEXELS, so there is no ambiguity left for a slab index to resolve.
        //
        // DILATE the RGB into the first solid shell instead of writing black there. The texture read is
        // a raw trilinear tap with no occupancy gate, so a black solid texel bleeds DARKNESS onto every
        // wall whose footprint touches it. The fragment tap is snapped to the air layer's centres along
        // the normal axis, so that layer is all this can affect - the IN-PLANE neighbours at a concave
        // corner. Filling the shell with its air neighbours' irradiance reconstructs the value the tap
        // would have read if the corner cell were air.
        // Same shape as OcclusionFieldTrace's CSDilate, and one shell suffices for its reason: the tap
        // sits at an air-cell centre, so its footprint reaches at most one voxel into the solid.
        //
        // Safe in place, more strongly than CSDilate: this reads _Irradiance, which CSBlur never writes
        // (it writes _IrradianceBlur and the mirror texture), so no thread can observe a partial write.
        // 1/distance weights keep the face neighbours dominant over the diagonals, which limits how far
        // a value can be pulled around a corner from the far side of a perpendicular wall.
        //
        // NOT confidence-eased, unlike the air path: that would need the previous texel back out of
        // _BgiIrradianceTexWrite, and a storage texture is write-only under WebGPU. Safe to skip here -
        // _Irradiance is already the temporally accumulated mean (so the shell doesn't shimmer) and the
        // shell only ever carries minority in-plane weight, so at worst a concave corner brightens a
        // frame ahead of the air around it during a light change.
        // FRONT HEMISPHERE ONLY, by this voxel's own surface normal. A wall thinner than a voxel is a
        // SINGLE solid shell with lit air on both sides; averaging all 26 neighbours hands the dark side
        // the bright side's irradiance, i.e. light pulled straight through the wall. Measured on Sponza's
        // lower arcade, the ungated average ran ~10% brighter than the reference there. Gating on
        // dot(dir, normal) restricts the average to the air the front face actually sees, which is the
        // same air the fragment's tap reads, so the shell now reconstructs that side and only that side.
        // Every solid voxel has a normal (CSBuildSurface's occupancy gradient, or the voxelizer's
        // triangle normal where that cancels), so this is always available.
        // A two-sided voxel serves two opposite faces from this ONE texel, so with SINGLE's one bucket
        // there is no hemisphere that is "in front" of it: the gate fills the texel with the air on
        // whichever side the voxelizer happened to store, and the other side reads it too. That is the
        // "walls at least two voxels thick" assumption Single trades for its one-tap read, and it only
        // ever shows up as in-plane shell weight next to a thin wall.
        //
        // CUBE has the missing degree of freedom: each bucket is filled from the air on ITS OWN side
        // (below), so a sub-voxel wall's two faces get genuinely different values out of the same cell.
        uint idirs = BgiIrradianceDirs();
        bool perBucket = idirs > 1u;

        float3 sn = BgiSurfaceNormal(sword);
        int3 sc = (int3)BgiCoord(i);
        // One accumulator per bucket. In Cube the WEIGHTS are per bucket too (each bucket keeps its
        // own side's air); in Single they are shared, since one value serves every direction. Either
        // way this stays a 26-neighbour walk, and the buckets of one neighbour are contiguous in
        // memory - the extra reads are a burst, not a scatter. fp32 sums, same headroom reason as the
        // air blur below.
        // FOUR levels, in this order, because the grown gate can legitimately exclude everything.
        //   dsum        - front hemisphere AND grown-air: the answer wherever one exists
        //   dsumAll     - grown-air, any direction. THIS is what fixes the concave corner: with the
        //                 grown-sealed neighbours gone the hemisphere set is empty, and this lands on
        //                 the room's air alone (corner cell 0.0097 -> 0.3394 against a room of ~0.38).
        //   dsumFrontRaw- front hemisphere over REAL air: exactly the pre-gate rule, for cells where
        //                 the grown gate excluded everything.
        //   dsumRaw     - real air, any direction: last resort. Writing black instead would be the
        //                 dark bleed this whole branch exists to stop.
        //
        // THE THIRD LEVEL IS NOT OPTIONAL and its position is the whole subtlety. A SUB-VOXEL wall
        // grows from BOTH faces, so the grown set seals the air on both sides of it and the first two
        // levels come back empty - dropping straight to dsumRaw hands that wall's dark side the lit
        // side's irradiance, which is precisely the leak the hemisphere gate exists to prevent.
        // Measured on Sponza: 3,107 of its shell cells reach this depth (808 on Playground, which is
        // why it did not show there), brightening by +0.019 each without this level.
        //
        // It must come AFTER dsumAll, not before. At a concave corner the front hemisphere over RAW
        // air is the sky - the original defect - so preferring it there would undo the fix. The order
        // encodes which question is better posed: "air my own geometry did not seal" beats "air in
        // front of a normal that may be pointing out of the building".
        float3 dsum[6], dsumAll[6], dsumFrontRaw[6], dsumRaw[6];
        float dwsumB[6];
        [unroll] for (uint b0 = 0u; b0 < 6u; b0++) { dsum[b0] = 0.0; dsumAll[b0] = 0.0; dsumFrontRaw[b0] = 0.0; dsumRaw[b0] = 0.0; dwsumB[b0] = 0.0; }
        float dwsum = 0.0;    // front hemisphere AND grown-air (Single)
        float dwsumAll = 0.0; // grown-air, ungated
        float dwsumFrontRaw = 0.0; // front hemisphere over real air - the pre-gate rule
        float dwsumRaw = 0.0;      // real air, ungated - last resort
        // Left rolled (like CSDilate): 27 unrolled iterations would bloat the kernel for a branch only
        // the solid minority takes, and the loop is bandwidth-bound on the occupancy tests anyway.
        for (int dz = -1; dz <= 1; dz++)
        for (int dy = -1; dy <= 1; dy++)
        for (int dx = -1; dx <= 1; dx++) {
            if ((dx | dy | dz) == 0) continue; // self
            int3 nb = sc + int3(dx, dy, dz);
            if (!BgiInBounds(nb)) continue;
            uint nbSlot = BgiSlot((uint3)nb);
            if (BgiSolidBit(nbSlot)) continue; // read ONLY air, write ONLY solid
            float3 dir = float3(dx, dy, dz);
            float w = rsqrt(dot(dir, dir)); // face 1, edge .71, corner .58
            bool front = dot(dir, sn) > 0.0; // behind the surface: pulling this through is the leak
            // GROWN GATE: air a surface in this neighbourhood grew into is air on the OTHER side of
            // that surface, whatever `sn` says. At a concave corner `sn` is the lighting-grid
            // occupancy gradient and points at the biggest air volume - the sky, outside a closed
            // room - so the hemisphere test picks the outdoors and rejects all three room-side
            // diagonals. This test does not consult a normal at all, so it cannot make that mistake.
            bool grownAir = (_BgiGrownGate == 0) || !BgiGrownSolidBit(nbSlot);
            uint nbase = BgiIrradianceBase(nbSlot);
            [unroll]
            for (uint b = 0u; b < 6u; b++) {
                if (b >= idirs) break;
                half3 nc; half nsun;
                BgiUnpackRgbH(_Irradiance[nbase + b], nc, nsun);
                dsumRaw[b] += (float3)nc * w;
                if (front) dsumFrontRaw[b] += (float3)nc * w;
                if (!grownAir) continue;
                dsumAll[b] += (float3)nc * w;
                if (!perBucket) {
                    if (front) dsum[b] += (float3)nc * w;
                    continue;
                }
                // CUBE: this bucket takes only the air on its own side, COSINE-weighted about its axis
                // (times the same 1/distance falloff). The cosine is |component| / |dir|, so the
                // combined weight is |component| * w * w. A neighbour perpendicular to the bucket's
                // axis gets exactly 0 - so the hemisphere cut costs no discontinuity, it just falls
                // out of the weighting - and the face neighbour straight along the axis dominates.
                float comp = (b >> 1u) == 0u ? dir.x : (((b >> 1u) == 1u) ? dir.y : dir.z);
                bool positive = (b & 1u) != 0u;
                if (positive ? (comp <= 0.0) : (comp >= 0.0)) continue; // other side (or perpendicular)
                float wB = abs(comp) * w * w;
                dsum[b] += (float3)nc * wB;
                dwsumB[b] += wB;
            }
            dwsumRaw += w;
            if (front) dwsumFrontRaw += w;
            if (!grownAir) continue;
            dwsumAll += w;
            if (front) dwsum += w;
        }
        // Prefer the bucket's own side (Cube) / the front hemisphere (Single); fall back to the
        // grown-air neighbours when there is none - a bucket facing into solid, or a degenerate
        // normal - and to RAW air only when the grown gate emptied the set, rather than writing
        // black, which is the dark bleed this whole branch exists to fix.
        // Nothing at all = deep interior. Stays black; no tap can ever sample it.
        [unroll]
        for (uint b1 = 0u; b1 < 6u; b1++) {
            if (b1 >= idirs) break;
            float own = perBucket ? dwsumB[b1] : dwsum;
            float3 dilated = (own > 0.0)           ? dsum[b1] / own
                           : (dwsumAll > 0.0)      ? dsumAll[b1] / dwsumAll
                           : (dwsumFrontRaw > 0.0) ? dsumFrontRaw[b1] / dwsumFrontRaw
                           : (dwsumRaw > 0.0)      ? dsumRaw[b1] / dwsumRaw : 0.0;

            // Confidence-eased exactly like the air path, from this bucket's own previous displayed
            // value. The shell carries in-plane weight at concave corners, so an un-eased jump to a
            // one-frame estimate reads as a burst of corner noise the moment anything restarts the
            // solve - while the air around it is still easing.
            uint blurSlot = BgiIrradianceBase(_FieldOffset + i) + b1;
            half3 prevShell; half prevShellW;
            BgiUnpackRgbH(_IrradianceBlur[blurSlot], prevShell, prevShellW);
            half3 shell = lerp(prevShell, (half3)dilated, (half)_Confidence);
            _IrradianceBlur[blurSlot] = BgiPackRgb(shell, 0.0);
            _BgiIrradianceTexWrite[BgiTexCoord(BgiCoord(i), b1)] = float4(shell, BGI_MIRROR_ALPHA_UNUSED);
        }
        return;
    }
    }

    // The blur sums at most 7 fp16 taps and divides by the count - the running sum can reach 7x a
    // field value, so it is accumulated in fp32 for the same headroom reason as the gather.
    int3 c = (int3)BgiCoord(i);
    uint airDirs = BgiIrradianceDirs();
    uint cbase = BgiIrradianceBase(_FieldOffset + i);
    // Per bucket, but the gate and the weights are shared - which neighbour is air does not depend on
    // direction - so this stays one 6-neighbour walk with a contiguous burst read per neighbour.
    float3 sum[6];
    [unroll] for (uint b0 = 0u; b0 < 6u; b0++) sum[b0] = 0.0;
    [unroll]
    for (uint bc = 0u; bc < 6u; bc++) {
        if (bc >= airDirs) break;
        half3 cc; half cs; BgiUnpackRgbH(_Irradiance[cbase + bc], cc, cs);
        sum[bc] = (float3)cc;
    }
    float wsum = 1.0;

    const int3 axes[6] = {
        int3(1,0,0), int3(-1,0,0), int3(0,1,0), int3(0,-1,0), int3(0,0,1), int3(0,0,-1)
    };
    [unroll]
    for (int k = 0; k < 6; k++) {
        int3 nb = c + axes[k];
        if (!BgiInBounds(nb)) continue;
        uint nbVoxel = BgiSlot((uint3)nb);
        if (BgiSolidBit(nbVoxel)) continue; // gate: don't blur across surfaces
        uint nbase = BgiIrradianceBase(nbVoxel);
        [unroll]
        for (uint b = 0u; b < 6u; b++) {
            if (b >= airDirs) break;
            half3 nc; half nsun;
            BgiUnpackRgbH(_Irradiance[nbase + b], nc, nsun);
            sum[b] += (float3)nc;
        }
        wsum += 1.0;
    }

    // Ease the displayed value from its previous state toward the freshly-blurred one by confidence,
    // so a light change fades in and completes exactly when the field has converged (confidence == 1).
    half3 result = 0.0h; // bucket 0, kept for the single-bucket texture write below
    [unroll]
    for (uint bw = 0u; bw < 6u; bw++) {
        if (bw >= airDirs) break;
        half3 blurred = (half3)(sum[bw] / wsum);
        half3 prevBlur; half pw;
        BgiUnpackRgbH(_IrradianceBlur[cbase + bw], prevBlur, pw);
        half3 r = lerp(prevBlur, blurred, (half)_Confidence);
        _IrradianceBlur[cbase + bw] = BgiPackRgb(r, 0.0);
        if (bw == 0u) result = r;
        if (airDirs > 1u) _BgiIrradianceTexWrite[BgiTexCoord(BgiCoord(i), bw)] = float4(r, BGI_MIRROR_ALPHA_UNUSED);
    }
    if (airDirs > 1u) return; // slabs already written above
    // Fused mirror: the displayed irradiance into the field's Texture3D rgb, the fragment's 1-tap GI
    // read. Sun visibility is no longer written here at all - CSSunVisibility owns it, at the shadow
    // grid rather than this one, and on the sun's schedule rather than the solve's.
    _BgiIrradianceTexWrite[BgiCoord(i)] = float4(result, BGI_MIRROR_ALPHA_UNUSED);
}

// ----------------------------------------------------------
// INIT FINE FROM COARSE: seed a freshly-switched fine field with the coarse field's DISPLAYED value
// (its _IrradianceBlur) so the fine box starts from the coarse approximation instead of black, then
// refines as the fine gather re-converges (the CSBlur confidence ease departs from this seed). The
// dispatch's _BgiGrid* uniforms are the FINE grid; _CoarseGrid* map into the coarse field.
// ----------------------------------------------------------
[numthreads(64, 1, 1)]
void CSInitFineFromCoarse(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= BGI_COUNT) return;

    uint fineSlot = BGI_FINE_OFFSET + i;
    BgiClearRadiance(fineSlot);
    if (BgiSolidBit(fineSlot)) { // irradiance lives only in air voxels
        BgiClearIrradiance(fineSlot);
        return;
    }

    // Coarse cell containing this fine voxel's world center.
    float3 world = BgiVoxelCenter(BgiCoord(i));
    int3 cc = (int3)floor(BgiWorldToGridAt(world, _CoarseGridOrigin, _CoarseGridVoxelSize));

    // Displayed coarse value there. Coarse voxels are big, so a fine air voxel near geometry can land
    // in a SOLID coarse cell (zero) - fall back to the average of that cell's air neighbours so
    // near-surface seeds aren't black.
    float3 seed = 0;
    if (BgiInBounds(cc)) {
        uint coarseSlot = BGI_COARSE_OFFSET + BgiIndex((uint3)cc);
        if (!BgiSolidBit(coarseSlot)) {
            half3 c; half w;
            BgiUnpackRgbH(_IrradianceBlur[coarseSlot], c, w);
            seed = (float3)c;
        } else {
            const int3 axes[6] = {
                int3(1,0,0), int3(-1,0,0), int3(0,1,0), int3(0,-1,0), int3(0,0,1), int3(0,0,-1)
            };
            float wsum = 0.0;
            [unroll]
            for (int k = 0; k < 6; k++) {
                int3 nb = cc + axes[k];
                if (!BgiInBounds(nb)) continue;
                uint nbSlot = BGI_COARSE_OFFSET + BgiIndex((uint3)nb);
                if (BgiSolidBit(nbSlot)) continue;
                half3 c; half w;
                BgiUnpackRgbH(_IrradianceBlur[nbSlot], c, w);
                seed += (float3)c; // fp32 sum for the same headroom reason as CSBlur
                wsum += 1.0;
            }
            seed = (wsum > 0.0) ? seed / wsum : 0.0;
        }
    }

    // Seed both: the blur is the displayed start value (the confidence ease departs from it), and the
    // raw irradiance keeps the first inject's bounce read consistent with it. In Cube every bucket
    // gets the same direction-less seed - it is a warm start that the first gathers refine, and the
    // coarse field it comes from has no direction to offer anyway.
    uint2 packed = BgiPackRgb(seed, 0.0);
    uint fbase = BgiIrradianceBase(fineSlot);
    uint fdirs = BgiIrradianceDirs();
    [loop]
    for (uint b = 0u; b < fdirs; b++) {
        _Irradiance[fbase + b] = packed;
        _IrradianceBlur[fbase + b] = packed;
    }
}

// ----------------------------------------------------------
// AVERAGE LUMINANCE (auto-exposure): accumulate the encoded log-luminance of the DISPLAYED field
// (_IrradianceBlur) over air voxels within _LuminanceRadius of the camera and in front of it,
// cosine-weighted by view alignment, into _LuminanceResult ([0] = encoded sum, [1] = count). The C#
// AutoExposure decodes avg log2 = (sum/count)/1024 - 16 (must match the texture-GI kernel's encoding).
// Dispatched per FIELD via _FieldOffset (the fine field near the camera).
// ----------------------------------------------------------
[numthreads(64, 1, 1)]
void CSAverageLuminance(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= BGI_COUNT) return;

    uint slot = _FieldOffset + i;
    if (BgiSolidBit(slot)) return; // GI lives in air voxels

    float3 voxelCenter = BgiVoxelCenter(BgiCoord(i));
    float3 offset = voxelCenter - _CameraPosition;
    float distSq = dot(offset, offset);
    if (distSq > _LuminanceRadius * _LuminanceRadius) return; // outside the sampling radius

    float invDist = rsqrt(max(distSq, 1e-6));
    float cosAngle = dot(offset * invDist, _CameraForward);
    if (cosAngle < 0.0) return; // behind the camera

    // Exposure has no surface normal to ask about, so it measures the direction-less mean over the
    // buckets - the same quantity the single-slot field always held, so auto-exposure behaves
    // identically in every mode rather than drifting when the field becomes directional.
    uint lbase = BgiIrradianceBase(slot);
    uint ldirs = BgiIrradianceDirs();
    float3 irrSum = 0;
    [loop]
    for (uint b = 0u; b < ldirs; b++) {
        half3 bc; half bw; BgiUnpackRgbH(_IrradianceBlur[lbase + b], bc, bw);
        irrSum += (float3)bc;
    }
    half3 irr = (half3)(irrSum / (float)ldirs);
    float lum = (float)GetRec709LuminanceH(irr) * cosAngle; // cosine-weight: off-axis voxels count less
    // The log encode stays fp32 and must: (logLum + 16) * 1024 reaches ~32768, where fp16's ulp is 16
    // - it would quantize the accumulated exposure estimate into visible steps.
    float logLum = log2(max(lum, 1e-4));
    uint encoded = (uint)((logLum + 16.0) * 1024.0);
    InterlockedAdd(_LuminanceResult[0], encoded);
    InterlockedAdd(_LuminanceResult[1], 1u);
}

